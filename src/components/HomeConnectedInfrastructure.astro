    @keyframes traceDraw{
      to{ stroke-dashoffset: 0; }
    }

    @keyframes scanSweep{
      0%{ transform: translateX(-110%); opacity:0; }
      12%, 72%{ opacity:1; }
      100%{ transform: translateX(390%); opacity:0; }
    }

    @keyframes scanFloat{
      0%,100%{ transform: translate3d(0,0,0) scale(.88); opacity:.58; }
      50%{ transform: translate3d(18px,-12px,0) scale(1.12); opacity:1; }
    }

    @keyframes stationPulse{
      0%,100%{ opacity:.54; transform: scale(.92); }
      48%{ opacity:1; transform: scale(1.18); }
    }

    @keyframes readoutSwap{
      from{ opacity:.35; transform: translateY(6px); filter: blur(4px); }
      to{ opacity:1; transform: translateY(0); filter: blur(0); }
    }

    @keyframes pointIn{
      from{ opacity:0; transform: translateY(5px); }
      to{ opacity:1; transform: translateY(0); }
    }

