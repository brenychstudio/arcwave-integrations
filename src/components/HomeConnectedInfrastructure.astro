    .scopeDataNodes circle:nth-child(3){ animation-delay:-1.4s; }
    .scopeDataNodes circle:nth-child(4){ animation-delay:-2.1s; }
    .scopeDataNodes circle:nth-child(5){ animation-delay:-2.8s; }
    .scopeDataNodes circle:nth-child(6){ animation-delay:-3.5s; }

    .scopeLabels text{
