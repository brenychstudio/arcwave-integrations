    }

    .consolePicker{
      border-right-color: rgba(30,44,60,.11);
      background:
        linear-gradient(180deg, rgba(255,255,255,.66), rgba(245,249,252,.38));
      box-shadow: inset -1px 0 0 rgba(255,255,255,.55);
    }

    .consolePicker button{
      border: 1px solid rgba(30,44,60,.045);
      background: rgba(255,255,255,.18);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.52);
    }

    .consolePicker button:hover,
    .consolePicker button:focus-visible,
    .consolePicker button.isActive{
      background:
        linear-gradient(135deg, rgb(var(--console-accent) / .10), rgba(255,255,255,.52) 44%, rgba(255,255,255,.26)),
        rgba(255,255,255,.54);
      border-color: rgb(var(--console-accent) / .16);
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.72),
        0 14px 36px rgba(12,20,32,.055);
    }

    .consolePicker strong,
    .consoleReadout h3,
    .readoutScore strong{
      letter-spacing:0;
    }

    .consoleScope{
      border-right-color: rgba(30,44,60,.10);
      background:
        linear-gradient(90deg, rgba(255,255,255,.28), transparent 28%, rgba(255,255,255,.18)),
        radial-gradient(520px 300px at 54% 36%, rgb(var(--console-accent) / .07), transparent 68%);
    }

    .scopeTopline{
      padding-bottom: 2px;
    }

    .scopeTopline strong{
      color: rgba(30,44,60,.72);
      font-weight: 760;
    }

    .scopeTopline em{
      display:inline-flex;
      align-items:center;
      gap: 8px;
      margin-left:auto;
      color: rgba(30,44,60,.58);
      font-size: 11px;
      font-style:normal;
      font-weight: 760;
      text-transform:uppercase;
      white-space:nowrap;
    }

    .scopeTopline em i{
      width: 7px;
      height: 7px;
      border-radius:999px;
      background: rgb(var(--console-accent) / .84);
      box-shadow:
        0 0 0 6px rgb(var(--console-accent) / .075),
        0 0 22px rgb(var(--console-accent) / .22);
      animation: stationPulse 2.8s ease-in-out infinite;
    }

    .scopeCanvas{
      min-height: 312px;
      border: 1px solid rgba(30,44,60,.075);
      border-radius: 24px;
      background:
        linear-gradient(rgba(30,44,60,.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30,44,60,.03) 1px, transparent 1px),
        linear-gradient(rgba(10,132,255,.026) 1px, transparent 1px),
        linear-gradient(90deg, rgba(10,132,255,.026) 1px, transparent 1px),
        radial-gradient(560px 260px at 58% 42%, rgb(var(--console-accent) / .075), transparent 68%),
        rgba(255,255,255,.30);
      background-size: 42px 42px, 42px 42px, 168px 168px, 168px 168px, auto, auto;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.72),
        inset 0 0 0 1px rgba(255,255,255,.34);
      mask-image:none;
    }

    .scopeCanvas:before,
    .scopeCanvas:after{
      content:"";
      position:absolute;
      pointer-events:none;
      z-index:2;
    }

    .scopeCanvas:before{
      inset:0;
      background:
        linear-gradient(90deg, rgba(255,255,255,.86), transparent 12%, transparent 88%, rgba(255,255,255,.78)),
        linear-gradient(180deg, rgba(255,255,255,.68), transparent 18%, transparent 82%, rgba(255,255,255,.56));
    }

    .scopeCanvas:after{
      left: 0;
      right: 0;
      top: 50%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(30,44,60,.12), transparent);
      opacity:.72;
