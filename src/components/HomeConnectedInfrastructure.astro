    .impactStrip:before{
      content:"";
      position:absolute;
      left:0;
      right:0;
      top:0;
      height:1px;
      background: linear-gradient(90deg, transparent, rgba(30,44,60,.12), transparent);
    }

    .impactStripHead{
      display:grid;
      grid-template-columns: minmax(220px, .42fr) minmax(0, .58fr);
      gap: clamp(22px, 4vw, 80px);
      align-items:end;
      margin-bottom: clamp(24px, 3vw, 44px);
