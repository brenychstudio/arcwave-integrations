    .impactStrip:has(.impactStat.isCounted) .impactLine span{
      width:100%;
    }

    .impactStats{
      display:grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(24px, 3vw, 58px);
      padding-inline: clamp(0px, 1vw, 18px);
