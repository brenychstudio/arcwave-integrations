    .telemetryCell strong{
      display:block;
      margin-top: 8px;
      color: rgba(15,15,20,.80);
      font-size: 18px;
      letter-spacing:0;
    }

    .valueRibbon{
      grid-template-columns: minmax(132px, .14fr) minmax(0, 1fr) minmax(330px, .34fr);
      border-color: rgba(30,44,60,.12);
      background:
        radial-gradient(860px 460px at 46% 42%, rgb(var(--console-accent) / .12), transparent 67%),
        linear-gradient(rgba(30,44,60,.042) 1px, transparent 1px),
        linear-gradient(90deg, rgba(30,44,60,.042) 1px, transparent 1px),
        linear-gradient(180deg, rgba(255,255,255,.82), rgba(241,247,252,.66));
      background-size: auto, 44px 44px, 44px 44px, auto;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.92),
        inset 0 -1px 0 rgba(30,44,60,.04),
        0 44px 130px rgba(12,20,32,.10);
