    :global(.logicClarified strong){
      display:block;
      max-width: 22ch;
      margin-top: 18px;
      color: rgba(30,44,60,.76);
      font-size: 15px;
      line-height:1.25;
      letter-spacing:0;
    }

    .valueRibbon{
      --console-accent: 10 132 255;
      position:relative;
      display:grid;
      grid-template-columns: minmax(116px, .16fr) minmax(0, 1fr) minmax(320px, .38fr);
      grid-template-rows: minmax(430px, auto) auto;
      min-height: 580px;
      margin-top: clamp(18px, 2.2vw, 32px);
      overflow:hidden;
      border-radius: 34px;
      border: 1px solid rgba(15,15,20,.075);
      background:
        radial-gradient(820px 420px at 46% 44%, rgb(var(--console-accent) / .135), transparent 66%),
        linear-gradient(rgba(10,132,255,.036) 1px, transparent 1px),
        linear-gradient(90deg, rgba(10,132,255,.036) 1px, transparent 1px),
        linear-gradient(180deg, rgba(255,255,255,.78), rgba(244,249,253,.58));
      background-size: auto, 48px 48px, 48px 48px, auto;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,.88),
        0 38px 120px rgba(10,10,20,.08);
      transition: background .42s ease, border-color .24s ease;
    }

    .valueRibbon:before,
    .valueRibbon:after{
      content:"";
      position:absolute;
      inset:0;
      pointer-events:none;
      z-index:1;
    }

    .valueRibbon:before{
      background:
        linear-gradient(90deg, rgba(255,255,255,.88) 0%, rgba(255,255,255,.18) 38%, rgba(255,255,255,.72) 100%),
        radial-gradient(780px 280px at 74% 22%, rgb(var(--console-accent) / .13), transparent 70%),
        radial-gradient(540px 260px at 18% 82%, rgba(205,158,60,.055), transparent 68%);
      opacity:.9;
    }

    .valueRibbon:after{
      inset:auto 0 0;
      height: 42%;
      background: linear-gradient(180deg, transparent, rgba(255,255,255,.56));
    }

    .consolePicker,
    .consoleScope,
    .consoleReadout,
    .consoleTelemetry{
      position:relative;
      z-index:2;
      min-width:0;
    }

    .consolePicker{
      grid-row: 1 / 3;
      display:flex;
      flex-direction:column;
      gap: 12px;
      padding: 22px 14px;
      border-right: 1px solid rgba(15,15,20,.07);
      background: linear-gradient(180deg, rgba(255,255,255,.58), rgba(255,255,255,.28));
      backdrop-filter: blur(18px) saturate(1.08);
      -webkit-backdrop-filter: blur(18px) saturate(1.08);
    }

    .consoleRailLabel,
    .scopeTopline span,
    .consoleReadout > div:first-child > span,
    .readoutScore span,
    .scopeMetric span,
    .telemetryCell span{
      color: rgb(var(--console-accent) / .72);
      font-size: 10.5px;
      letter-spacing:.18em;
      text-transform:uppercase;
      font-weight: 780;
    }

    .consoleRailLabel{
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      width: 100%;
      min-height: 108px;
      display:flex;
      align-items:center;
      justify-content:center;
      color: rgba(96,100,112,.62);
    }

    .consolePicker button{
      position:relative;
      display:grid;
      gap: 7px;
      min-height: 92px;
      padding: 12px 10px 12px 14px;
      border:0;
      border-radius: 18px;
      background: transparent;
      color: rgba(15,15,20,.64);
