    .pageNavTrack{
      position:absolute;
      left: 50%;
      top: 22px;
      bottom: 22px;
      width: 1px;
      overflow:hidden;
      background: rgba(10,132,255,.10);
      border-radius:999px;
      pointer-events:none;
      transform: translateX(-50%);
    }

    .pageNavTrack span{
      display:block;
      width:100%;
      height: calc(var(--page-progress, 0) * 100%);
      border-radius:999px;
      background: rgba(10,132,255,.62);
      box-shadow: 0 0 14px rgba(10,132,255,.18);
    }

    .pageNav a{
      position:relative;
      display:flex;
      align-items:center;
      justify-content:center;
      width: 28px;
      height: 28px;
      padding: 0;
      border-radius: 999px;
      color: rgba(15,15,20,.64);
      font-size: 11px;
      text-decoration:none;
      isolation:isolate;
      transition: transform .16s ease;
    }

    .pageNav a:before{
      content:"";
      position:absolute;
      left:50%;
      top: 50%;
      z-index:2;
      width: 6px;
      height: 6px;
      border-radius:999px;
      background: rgba(10,132,255,.42);
      box-shadow:
        0 0 0 4px rgba(10,132,255,.045),
        0 1px 0 rgba(255,255,255,.9);
      transform: translate(-50%, -50%);
      transition: background .16s ease, box-shadow .16s ease, transform .16s ease;
    }

    .pageNav a:after{
      content: attr(aria-label);
      position:absolute;
      right: calc(100% + 10px);
      top: 50%;
      max-width: 170px;
      padding: 7px 10px;
      border-radius: 999px;
      border: 1px solid rgba(15,15,20,.07);
      background: rgba(255,255,255,.78);
      backdrop-filter: blur(18px) saturate(1.14);
      -webkit-backdrop-filter: blur(18px) saturate(1.14);
      color: rgba(15,15,20,.68);
      box-shadow: 0 14px 36px rgba(10,10,20,.07);
      font-size: 9px;
      letter-spacing:.12em;
      line-height:1;
      text-transform:uppercase;
      white-space:nowrap;
      opacity:0;
      pointer-events:none;
      transform: translate(6px, -50%);
      transition: opacity .16s ease, transform .16s ease;
    }

    .pageNav a:hover,
    .pageNav a:focus-visible,
    .pageNav a.isActive{
      transform: scale(1.04);
      outline:none;
    }

    .pageNav a:hover:after,
    .pageNav a:focus-visible:after{
      opacity:1;
      transform: translate(0, -50%);
    }

    .pageNav a.isActive:before{
      background: rgba(10,132,255,.90);
      box-shadow:
        0 0 0 6px rgba(10,132,255,.095),
        0 0 20px rgba(10,132,255,.28);
      transform: translate(-50%, -50%) scale(1.28);
    }

    .pageNav a span{
      position:absolute;
      width:1px;
      height:1px;
      overflow:hidden;
      clip: rect(0 0 0 0);
      white-space:nowrap;
    }

    .pageNav a strong{
      position:absolute;
      width:1px;
      height:1px;
      overflow:hidden;
      clip: rect(0 0 0 0);
      white-space:nowrap;
    }

