      animation-duration: 13s;
      animation-direction: reverse;
    }

    .scopeDependencyLanes path:nth-child(3){
      animation-duration: 15s;
    }

    .scopeRiskBand{
      fill:none;
      stroke: url(#valueRiskGradient);
      stroke-width: 34;
      stroke-linecap:round;
      opacity:.52;
    }

    .scopeBand{
      stroke: rgba(30,44,60,.13);
      stroke-width: 1.1;
      stroke-dasharray: 12 18;
    }

    .scopeOrbit{
      stroke: rgb(var(--console-accent) / .13);
      stroke-width: 11;
      opacity:.64;
      filter: blur(3px);
    }

    .scopeTraceSoft{
