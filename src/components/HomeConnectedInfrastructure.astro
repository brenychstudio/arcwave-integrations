  <script>
    function initHomeV2FieldFocus() {
      const root = document.querySelector(".homeV2");
      if (!root || root.getAttribute("data-focus-ready") === "true") return;

      root.setAttribute("data-focus-ready", "true");

      const focusControls = document.querySelectorAll("[data-field-focus]");
      const focusSteps = document.querySelectorAll("[data-scroll-focus]");

      function setFieldFocus(key) {
        if (!key) return;

        window.dispatchEvent(
          new CustomEvent("arcwave:field-focus", {
            detail: { key },
          })
        );

        [...focusControls, ...focusSteps].forEach((item) => {
          const itemKey = item.getAttribute("data-field-focus") || item.getAttribute("data-scroll-focus");
          item.classList.toggle("isActive", itemKey === key);
        });
      }

      focusControls.forEach((control) => {
        const key = control.getAttribute("data-field-focus");
        control.addEventListener("mouseenter", () => setFieldFocus(key));
        control.addEventListener("focus", () => setFieldFocus(key));
        control.addEventListener("click", () => setFieldFocus(key));
      });

      const observer = new IntersectionObserver(
        (entries) => {
          const active = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (active?.target) {
            setFieldFocus(active.target.getAttribute("data-scroll-focus"));
          }
        },
        {
          rootMargin: "-42% 0px -42% 0px",
          threshold: [0.16, 0.32, 0.52],
        }
      );

      focusSteps.forEach((step) => observer.observe(step));

      const systemMap = document.querySelector(".systemMap");
      const systemNodes = document.querySelectorAll("[data-system-node]");

      if (systemMap && systemMap.getAttribute("data-map-ready") !== "true") {
        systemMap.setAttribute("data-map-ready", "true");

        const cycle = ["telecom", "networks", "electricity", "alarms", "ev", "audio"];
        let index = 0;
        let autoCycle = null;

        function setSystemFocus(key) {
          if (!key || key === "system") return;
          systemMap.setAttribute("data-active-system", key);

          systemNodes.forEach((node) => {
            node.classList.toggle("isActive", node.getAttribute("data-system-node") === key);
          });
        }

        systemNodes.forEach((node) => {
          const key = node.getAttribute("data-system-node");
          node.addEventListener("mouseenter", () => setSystemFocus(key));
          node.addEventListener("focus", () => setSystemFocus(key));
        });

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!prefersReducedMotion) {
          autoCycle = window.setInterval(() => {
            index = (index + 1) % cycle.length;
            setSystemFocus(cycle[index]);
          }, 2600);

          systemMap.addEventListener("mouseenter", () => {
            if (autoCycle) window.clearInterval(autoCycle);
          });

          systemMap.addEventListener("mouseleave", () => {
            autoCycle = window.setInterval(() => {
              index = (index + 1) % cycle.length;
              setSystemFocus(cycle[index]);
            }, 2600);
          });
        }

        setSystemFocus("telecom");
      }

      setFieldFocus("telecom");
    }

    function initQuoteInterface() {
      const form = document.querySelector("[data-quote-interface]");
      if (!form || form.getAttribute("data-quote-ready") === "true") return;

      form.setAttribute("data-quote-ready", "true");

      const mailto = form.querySelector("[data-quote-mailto]");
      const fallbackEmail = form.getAttribute("data-quote-email") || "";
      const subjectPrefix = form.getAttribute("data-mail-subject-prefix") || "ARCWAVE technical request";
      const mailLabels = {
        service: form.getAttribute("data-mail-service-label") || "Service path",
        space: form.getAttribute("data-mail-space-label") || "Space type",
        timing: form.getAttribute("data-mail-timing-label") || "Timing",
        constraints: form.getAttribute("data-mail-constraints-label") || "Known constraints",
        notes: form.getAttribute("data-mail-notes-label") || "Space notes",
      };
      const emptyConstraints = form.getAttribute("data-empty-constraints") || "No constraints selected";
      const emptyNotes = form.getAttribute("data-empty-notes") || "Add a short note to turn this into a cleaner technical request.";
      const emptyMailConstraints = form.getAttribute("data-empty-mail-constraints") || "None selected";
      const emptyMailNotes = form.getAttribute("data-empty-mail-notes") || "No notes added yet.";
      const outputs = {
        service: form.querySelector('[data-quote-output="service"]'),
        space: form.querySelector('[data-quote-output="space"]'),
        timeline: form.querySelector('[data-quote-output="timeline"]'),
        constraints: form.querySelector('[data-quote-output="constraints"]'),
        notes: form.querySelector('[data-quote-output="notes"]'),
      };

      function selectedRadio(name) {
        return form.querySelector(`input[name="${name}"]:checked`)?.value || "";
      }

      function selectedConstraints() {
        return [...form.querySelectorAll('[data-quote-field="constraint"]:checked')].map((item) => item.value);
      }

      function updateBrief() {
        const service = selectedRadio("service") || "Networks";
        const space = form.querySelector('[data-quote-field="space"]')?.value || "Apartment";
        const timeline = form.querySelector('[data-quote-field="timeline"]')?.value || "Planning";
        const constraints = selectedConstraints();
        const notes = form.querySelector('[data-quote-field="notes"]')?.value.trim() || "";

        outputs.service.textContent = service;
        outputs.space.textContent = space;
        outputs.timeline.textContent = timeline;
        outputs.constraints.textContent = constraints.length ? constraints.join(", ") : emptyConstraints;
        outputs.notes.textContent = notes || emptyNotes;

        form.querySelectorAll(".quoteServiceGrid label").forEach((label) => {
          label.classList.toggle("isSelected", label.querySelector("input")?.checked);
        });

        form.querySelectorAll(".constraintGrid label").forEach((label) => {
          label.classList.toggle("isSelected", label.querySelector("input")?.checked);
        });

        if (mailto && fallbackEmail) {
          const subject = `${subjectPrefix} - ${service}`;
          const body = [
            subjectPrefix,
            "",
            `${mailLabels.service}: ${service}`,
            `${mailLabels.space}: ${space}`,
            `${mailLabels.timing}: ${timeline}`,
            `${mailLabels.constraints}: ${constraints.length ? constraints.join(", ") : emptyMailConstraints}`,
            "",
            `${mailLabels.notes}:`,
            notes || emptyMailNotes,
          ].join("\n");

          mailto.setAttribute(
            "href",
            `mailto:${encodeURIComponent(fallbackEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
          );
        } else if (mailto) {
          mailto.removeAttribute("href");
        }
      }

      form.addEventListener("input", updateBrief);
      form.addEventListener("change", updateBrief);
      form.addEventListener("submit", (event) => event.preventDefault());
      updateBrief();
    }

    function initPageNavigation() {
      const nav = document.querySelector("[data-page-nav]");
      if (!nav || nav.getAttribute("data-page-nav-ready") === "true") return;

      nav.setAttribute("data-page-nav-ready", "true");

      const links = [...nav.querySelectorAll("[data-page-nav-link]")];
      const progress = nav.querySelector("[data-page-progress]");
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter(Boolean);

      function setActive(id) {
        links.forEach((link) => {
          const isActive = link.getAttribute("href") === `#${id}`;
          link.classList.toggle("isActive", isActive);
          if (isActive) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
      }

      links.forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.getAttribute("href")?.slice(1);
          if (id) setActive(id);
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          const active = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (active?.target?.id) setActive(active.target.id);
        },
        {
          rootMargin: "-38% 0px -48% 0px",
          threshold: [0.05, 0.16, 0.32, 0.5],
        }
      );

      sections.forEach((section) => observer.observe(section));

      let ticking = false;

      function updateProgress() {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const value = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        if (progress) progress.style.setProperty("--page-progress", value.toFixed(4));
        ticking = false;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateProgress);
          }
        },
        { passive: true }
      );

      setActive(sections[0]?.id || "signal-field");
      updateProgress();
    }

    function initImpactStrip() {
      const strip = document.querySelector("[data-impact-strip]");
      if (!strip || strip.getAttribute("data-impact-ready") === "true") return;

      strip.setAttribute("data-impact-ready", "true");

      const stats = [...strip.querySelectorAll("[data-impact-stat]")];
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      function formatNumber(value) {
        return new Intl.NumberFormat("en-US").format(Math.round(value));
      }

      function animateValue(target) {
        const valueEl = target.querySelector("[data-impact-value]");
        if (!valueEl) return;

        const finalValue = Number(valueEl.getAttribute("data-target") || "0");
        const suffix = valueEl.getAttribute("data-suffix") || "";

        if (prefersReducedMotion) {
          valueEl.textContent = `${formatNumber(finalValue)}${suffix}`;
          target.classList.add("isCounted");
          return;
        }

        const duration = 1250 + finalValue * 2;
        const startedAt = performance.now();

        function tick(now) {
          const progress = Math.min(1, (now - startedAt) / duration);
          const eased = 1 - Math.pow(1 - progress, 3);
          valueEl.textContent = `${formatNumber(finalValue * eased)}${suffix}`;

          if (progress < 1) {
            window.requestAnimationFrame(tick);
          } else {
            valueEl.textContent = `${formatNumber(finalValue)}${suffix}`;
            target.classList.add("isCounted");
          }
        }

        window.requestAnimationFrame(tick);
      }

      stats.forEach((stat, index) => {
        stat.style.setProperty("--impact-index", String(index));
      });

      function runSequence() {
        if (strip.getAttribute("data-impact-animated") === "true") return;
        strip.setAttribute("data-impact-animated", "true");

        stats.forEach((stat, index) => {
          const delay = prefersReducedMotion ? 0 : index * 140;
          window.setTimeout(() => animateValue(stat), delay);
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          if (!entries.some((entry) => entry.isIntersecting)) return;
          runSequence();
          observer.disconnect();
        },
        { threshold: 0.24, rootMargin: "0px 0px -8% 0px" }
      );

      observer.observe(strip);
    }

    function initHomeV2Motion() {
      const root = document.querySelector(".homeV2");
      if (!root || root.getAttribute("data-motion-ready") === "true") return;

      root.setAttribute("data-motion-ready", "true");

      const revealTargets = root.querySelectorAll(
        [
          ".systemSection .sectionHead",
          ".systemMap",
          ".impactStrip",
          ".valueCard",
          ".pathSection .sectionHead",
          ".pathStage",
          ".pathItem",
          ".featuredSection .sectionHead",
          ".featuredCard",
          ".quoteFlowCopy",
          ".quoteInterface",
          ".quotePanel",
          ".briefPanel",
        ].join(",")
      );

      revealTargets.forEach((item, index) => {
        item.classList.add("motionReveal");
        item.style.setProperty("--motion-index", String(index % 6));
      });

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion) {
        revealTargets.forEach((item) => item.classList.add("isVisible"));
        return;
      }

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("isVisible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        {
          rootMargin: "0px 0px -14% 0px",
          threshold: [0.12, 0.28],
        }
      );

      revealTargets.forEach((item) => revealObserver.observe(item));

      function revealVisibleTargets() {
        revealTargets.forEach((item) => {
          if (item.classList.contains("isVisible")) return;

          const rect = item.getBoundingClientRect();
          const isVisible = rect.top < window.innerHeight * 0.92 && rect.bottom > window.innerHeight * 0.04;

          if (isVisible) {
            item.classList.add("isVisible");
            revealObserver.unobserve(item);
          }
        });
      }

      window.requestAnimationFrame(revealVisibleTargets);
      window.setTimeout(revealVisibleTargets, 180);
      window.setTimeout(revealVisibleTargets, 700);

      let ticking = false;

      function updateScrollMotion() {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        root.style.setProperty("--scroll-motion", progress.toFixed(4));
        root.style.setProperty("--scroll-drift", `${(progress * -72).toFixed(2)}px`);
        ticking = false;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateScrollMotion);
          }
        },
        { passive: true }
      );

      updateScrollMotion();
    }

    initHomeV2FieldFocus();
    initImpactStrip();
    initQuoteInterface();
    initPageNavigation();
    initHomeV2Motion();
    document.addEventListener("astro:page-load", () => {
      initHomeV2FieldFocus();
      initImpactStrip();
      initQuoteInterface();
      initPageNavigation();
      initHomeV2Motion();
    });
  </script>

