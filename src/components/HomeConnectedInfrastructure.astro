---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalInfrastructureField from "./SignalInfrastructureField";
import { services } from "../content/services";
import { COMPANY } from "../content/company";

const featuredServices = services.filter((service) =>
  ["networks", "electricity", "alarms"].includes(service.key)
);

const systemNodes = [
  {
    key: "telecom",
    label: "Telecom",
    signal: "Long-distance signal",
    note: "Lines, terminations, provider handoff",
  },
  {
    key: "networks",
    label: "Networks",
    signal: "Stable connectivity",
    note: "Wi-Fi, access points, topology",
  },
  {
    key: "electricity",
    label: "Electricity",
    signal: "Power + control",
    note: "Panels, circuits, smart-ready wiring",
  },
  {
    key: "ev",
    label: "EV Charging",
    signal: "Energy delivery",
    note: "Charging points and safe routing",
  },
  {
    key: "alarms",
    label: "Security",
    signal: "Protected perimeter",
    note: "Alarms, CCTV, zones, monitoring-ready",
  },
  {
    key: "audio",
    label: "Audio",
    signal: "Sound field",
    note: "Home cinema, multiroom, venue audio",
  },
];

const process = [
  {
    step: "01",
    title: "Signal",
    text: "The need is identified: connectivity, power, security, comfort or audio.",
    input: "Need / issue",
    output: "Initial signal",
    details: ["Service category", "Space type", "Main pain point"],
  },
  {
    step: "02",
    title: "System",
    text: "Services are mapped as one technical layer, not isolated tasks.",
    input: "Service mix",
    output: "System view",
    details: ["Network + power dependencies", "Security / comfort layers", "Access points"],
  },
  {
    step: "03",
    title: "Service path",
    text: "Scope, constraints, installation route and handover are clarified.",
    input: "Site constraints",
    output: "Install path",
    details: ["Routes and distances", "Panel / rack locations", "Building constraints"],
  },
  {
    step: "04",
    title: "Proof",
    text: "Technical clarity, diagrams, handoff notes and bilingual service structure build trust.",
    input: "Technical plan",
    output: "Clarity pack",
    details: ["Labels and notes", "Expected outcome", "Support-ready handover"],
  },
  {
    step: "05",
    title: "Quote",
    text: "The request becomes a clear technical brief for the space.",
    input: "Confirmed scope",
    output: "Quote brief",
    details: ["Selected service", "Space notes", "Next response"],
  },
];

const valueCards = [
  {
    step: "01 / Planning",
    title: "One partner",
    text: "Telecom, network, power, security and audio are planned as one scope.",
    signal: "Unified scope",
    outcome: "Fewer coordination gaps",
    points: ["Telecom + network dependencies", "Power and device locations", "Security/audio readiness"],
    score: "92",
    scoreLabel: "Scope clarity",
    accent: "10 132 255",
    path: "M52 252 C182 88 318 80 454 178 C586 274 694 290 832 90",
    metrics: [
      { label: "Layers aligned", value: "5", level: 86 },
      { label: "Decision points", value: "12", level: 72 },
      { label: "Quote readiness", value: "High", level: 92 },
    ],
    telemetry: [
      { label: "Signal", value: "88", level: 88 },
      { label: "Network", value: "94", level: 94 },
      { label: "Power", value: "81", level: 81 },
      { label: "Security", value: "76", level: 76 },
      { label: "Audio", value: "68", level: 68 },
      { label: "Quote", value: "92", level: 92 },
    ],
  },
  {
    step: "02 / Handover",
    title: "Clean handover",
    text: "Labels, routes, constraints and practical notes keep the system supportable.",
    signal: "Supportable system",
    outcome: "Easier maintenance",
    points: ["Cable routes and labels", "Access notes", "As-built practical context"],
    score: "86",
    scoreLabel: "Handover readiness",
    accent: "35 198 190",
    path: "M52 214 C178 158 262 230 390 158 C540 74 640 128 832 196",
    metrics: [
      { label: "Label coverage", value: "Clear", level: 88 },
      { label: "Route notes", value: "Mapped", level: 82 },
      { label: "Support context", value: "Ready", level: 86 },
    ],
    telemetry: [
      { label: "Signal", value: "74", level: 74 },
      { label: "Network", value: "89", level: 89 },
      { label: "Power", value: "84", level: 84 },
      { label: "Security", value: "80", level: 80 },
      { label: "Audio", value: "71", level: 71 },
      { label: "Quote", value: "86", level: 86 },
    ],
  },
  {
    step: "03 / Lifecycle",
    title: "Future-ready",
    text: "The installation is prepared for upgrades, extensions and new service layers.",
    signal: "Upgrade path",
    outcome: "Lower future friction",
    points: ["Smart-ready wiring", "Expansion zones", "Clean service path"],
    score: "78",
    scoreLabel: "Expansion readiness",
    accent: "205 158 60",
    path: "M52 278 C168 230 248 132 376 128 C548 122 634 240 832 166",
    metrics: [
      { label: "Expansion zones", value: "Open", level: 78 },
      { label: "Control points", value: "Planned", level: 74 },
      { label: "Future services", value: "Ready", level: 82 },
    ],
    telemetry: [
      { label: "Signal", value: "68", level: 68 },
      { label: "Network", value: "76", level: 76 },
      { label: "Power", value: "90", level: 90 },
      { label: "Security", value: "72", level: 72 },
      { label: "Audio", value: "80", level: 80 },
      { label: "Quote", value: "78", level: 78 },
    ],
  },
];

const journeyFocus = [
  {
    key: "telecom",
    step: "01",
    label: "Telecom",
    title: "Signal enters the space",
    text: "Provider handoff, fiber/copper lines and the technical entry point become visible.",
  },
  {
    key: "networks",
    step: "02",
    label: "Networks",
    title: "Connectivity becomes stable",
    text: "Wi-Fi, access points and topology are planned as a supportable layer.",
  },
  {
    key: "electricity",
    step: "03",
    label: "Power",
    title: "Energy gets routed and controlled",
    text: "Panels, circuits and smart-ready wiring prepare the space for upgrades.",
  },
  {
    key: "security",
    step: "04",
    label: "Security",
    title: "The perimeter becomes clear",
    text: "Alarms, CCTV and zones connect to the wider infrastructure plan.",
  },
  {
    key: "quote",
    step: "05",
    label: "Quote",
    title: "The request becomes actionable",
    text: "The technical path turns into a clear quote brief for the installation.",
  },
];

const quoteSpaceTypes = ["Apartment", "House / villa", "Office", "Retail / hospitality", "Technical room"];
const quoteTimelines = ["Planning", "This month", "1-3 months", "Urgent site issue"];
const quoteConstraints = ["Existing wiring", "New renovation", "Provider handoff", "Panel / rack access", "Outdoor routing", "Barcelona area"];

const pageNavItems = [
  { href: "#signal-field", index: "01", label: "Signal" },
  { href: "#system-map", index: "02", label: "System" },
  { href: "#service-journey", index: "03", label: "Path" },
  { href: "#featured-services", index: "04", label: "Services" },
  { href: "#technical-request", index: "05", label: "Quote" },
];

type PageProps = {
  title?: string;
  description?: string;
  noindex?: boolean;
};

const {
  title: layoutTitle = "Connected Infrastructure OS for Modern Spaces",
  description: layoutDescription = "ARCWAVE designs and integrates telecom, networks, electricity, smart home, EV charging, security and audio systems as one reliable technical layer.",
  noindex: layoutNoindex = false,
} = Astro.props as PageProps;
---

<BaseLayout
  title={layoutTitle}
  description={layoutDescription}
  noindex={layoutNoindex}
>
  <div class="homeV2">
  <div class="livingAtmosphere" aria-hidden="true">
    <div class="atmoLayer atmoGrid"></div>
    <div class="atmoLayer atmoField"></div>
    <div class="atmoLayer atmoSignals"></div>
    <div class="atmoLayer atmoNoise"></div>
  </div>

  <nav class="pageNav" data-page-nav aria-label="Home section navigation">
    <div class="pageNavTrack" aria-hidden="true"><span data-page-progress></span></div>
    {pageNavItems.map((item) => (
      <a href={item.href} data-page-nav-link aria-label={item.label}>
        <span>{item.index}</span>
        <strong>{item.label}</strong>
      </a>
    ))}
  </nav>

  <section id="signal-field" class="v2Hero">
    <div class="heroGrid">
      <div class="heroCopy">
        <div class="conceptLabel">Connected Infrastructure OS</div>

        <h1>Invisible infrastructure, precisely integrated.</h1>

        <p class="lead">
          Telecom, networks, electricity, smart home, EV charging, security and audio systems -
          planned as one reliable technical layer for modern spaces.
        </p>

        <div class="actions">
          <a class="primary" href="#technical-request" data-vt="1">Request a quote</a>
          <a class="secondary" href="/services" data-vt="1">Explore services</a>
        </div>

        <div class="signalFormula" aria-label="Commercial journey">
          <span>signal</span>
          <i></i>
          <span>system</span>
          <i></i>
          <span>service path</span>
          <i></i>
          <span>proof</span>
          <i></i>
          <span>quote</span>
        </div>

        <div class="focusRail" aria-label="Infrastructure focus path">
          {journeyFocus.map((item) => (
            <button type="button" data-field-focus={item.key}>
              <span>{item.step}</span>
              {item.label}
            </button>
          ))}
        </div>
      </div>

      <div class="signalStage" aria-label="Signal Infrastructure Field">
        <SignalInfrastructureField client:only="react" />
        <div class="stageCaption">
          <span>Signal Infrastructure Field</span>
          <small>Live topology layer</small>
        </div>
      </div>
    </div>

    <div class="scrollFocusStack" aria-label="Infrastructure journey">
      {journeyFocus.map((item) => (
        <article class="focusStep" data-scroll-focus={item.key}>
          <span>{item.step} / {item.label}</span>
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <div class="container"><div class="hr"></div></div>

  <section id="system-map" class="systemSection">
    <div class="container">
      <div class="sectionHead">
        <div class="eyebrow">Connected services map</div>
        <h2>One technical layer. Six connected service paths.</h2>
        <p>
          ARCWAVE presents infrastructure as an integrated system: signal, power,
          security, comfort and audio - designed to work together.
        </p>
      </div>

      <div class="systemMap" data-active-system="telecom">
        <div class="mapHud" aria-hidden="true">
          <span>Live service topology</span>
          <strong>Connected Infrastructure OS</strong>
        </div>

        <div class="mapRoutes" aria-hidden="true">
          <span class="route routeSignal"></span>
          <span class="route routePower"></span>
          <span class="route routeSecurity"></span>
          <span class="route routeSupport"></span>
        </div>

        <svg class="mapFlow" viewBox="0 0 1000 520" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="flowBlue" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="rgba(10,132,255,0)" />
              <stop offset="48%" stop-color="rgba(10,132,255,.72)" />
              <stop offset="100%" stop-color="rgba(10,132,255,0)" />
            </linearGradient>
            <linearGradient id="flowAmber" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="rgba(255,186,94,0)" />
              <stop offset="50%" stop-color="rgba(205,158,60,.72)" />
              <stop offset="100%" stop-color="rgba(255,186,94,0)" />
            </linearGradient>
            <linearGradient id="flowCyan" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="rgba(35,198,190,0)" />
              <stop offset="52%" stop-color="rgba(35,198,190,.62)" />
              <stop offset="100%" stop-color="rgba(35,198,190,0)" />
            </linearGradient>
          </defs>

          <ellipse class="flowOrbit" cx="500" cy="260" rx="430" ry="205" />
          <path class="flowLine flowTelecom" d="M500 260 C410 218 285 146 132 132" />
          <path class="flowLine flowNetworks" d="M500 260 C630 205 750 142 868 132" />
          <path class="flowLine flowElectricity" d="M500 260 C410 305 285 382 168 392" />
          <path class="flowLine flowEv" d="M500 260 C626 314 742 388 866 390" />
          <path class="flowLine flowAlarms" d="M500 260 C502 206 502 126 500 82" />
          <path class="flowLine flowAudio" d="M500 260 C502 322 502 398 500 442" />
        </svg>

        <div class="mapBeacons" aria-hidden="true">
          <span class="b1"></span>
          <span class="b2"></span>
          <span class="b3"></span>
          <span class="b4"></span>
        </div>

        {systemNodes.map((node, index) => (
          <a
            class={`systemNode n${index + 1}`}
            href={`/services/${node.key}`}
            data-vt="1"
            data-system-node={node.key}
            aria-label={`Open ${node.label}`}
          >
            <span class="nodeIndex">{String(index + 1).padStart(2, "0")}</span>
            <strong>{node.label}</strong>
            <em>{node.signal}</em>
            <p>{node.note}</p>
          </a>
        ))}

        <div class="mapCore" data-system-node="system">
          <span>Integrated</span>
          <strong>System</strong>
        </div>
      </div>

      <div class="valueRibbon" data-value-console aria-label="Integration value console">
        <div class="consolePicker" role="tablist" aria-label="Integration outcomes">
          <span class="consoleRailLabel">Value model</span>
          {valueCards.map((item, index) => (
            <button
              type="button"
              class={index === 0 ? "isActive" : ""}
              data-value-tab
              data-title={item.title}
              data-text={item.text}
              data-signal={item.signal}
              data-outcome={item.outcome}
              data-points={item.points.join("|")}
              data-score={item.score}
              data-score-label={item.scoreLabel}
              data-path={item.path}
              data-accent={item.accent}
              data-metrics={JSON.stringify(item.metrics)}
              data-telemetry={JSON.stringify(item.telemetry)}
              aria-selected={index === 0 ? "true" : "false"}
            >
              <span>{item.step}</span>
              <strong>{item.signal}</strong>
              <em>{item.outcome}</em>
            </button>
          ))}
        </div>

        <div class="consoleScope" aria-label="Diagnostic value diagram">
          <div class="scopeTopline">
            <span>Diagnostic model</span>
            <strong data-console-signal>{valueCards[0].signal}</strong>
          </div>

          <div class="scopeCanvas">
            <svg viewBox="0 0 900 360" preserveAspectRatio="none" aria-hidden="true">
            <defs>
              <linearGradient id="valueTraceGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="rgb(var(--console-accent) / 0)" />
                <stop offset="46%" stop-color="rgb(var(--console-accent) / .95)" />
                <stop offset="100%" stop-color="rgb(var(--console-accent) / 0)" />
              </linearGradient>
              <filter id="valueGlow" x="-20%" y="-60%" width="140%" height="220%">
                <feGaussianBlur stdDeviation="6" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <path class="scopeGridLine scopeGridLineA" d="M0 90 H900 M0 180 H900 M0 270 H900" />
            <path class="scopeGridLine scopeGridLineB" d="M150 0 V360 M300 0 V360 M450 0 V360 M600 0 V360 M750 0 V360" />
            <path class="scopeBand" d="M50 286 C170 210 280 206 390 240 C520 282 632 254 850 168" />
            <path class="scopeOrbit" data-scope-orbit d={valueCards[0].path} />
            <path class="scopeTrace isDrawing" data-scope-trace d={valueCards[0].path} />
            <g class="scopeStations">
              <circle cx="158" cy="160" r="5" />
              <circle cx="382" cy="136" r="5" />
              <circle cx="612" cy="230" r="5" />
              <circle cx="760" cy="134" r="5" />
            </g>
          </svg>
            <span class="scopeScan"></span>
            <span class="scanDot d1"></span>
            <span class="scanDot d2"></span>
            <span class="scanDot d3"></span>
          </div>

          <div class="scopeMetricGrid">
            {valueCards[0].metrics.map((metric) => (
              <div class="scopeMetric" data-console-metric style={`--level: ${metric.level}%`}>
                <span>{metric.label}</span>
                <strong>{metric.value}</strong>
                <i aria-hidden="true"></i>
              </div>
            ))}
          </div>
        </div>

        <div class="consoleReadout">
          <div>
            <span data-console-step>{valueCards[0].step}</span>
            <h3 data-console-title>{valueCards[0].title}</h3>
            <p data-console-text>{valueCards[0].text}</p>
          </div>

          <div class="readoutScore">
            <strong data-console-score>{valueCards[0].score}</strong>
            <span data-console-score-label>{valueCards[0].scoreLabel}</span>
            <em data-console-outcome>{valueCards[0].outcome}</em>
          </div>

          <ul class="consolePoints" data-console-points>
            {valueCards[0].points.map((point) => <li>{point}</li>)}
          </ul>
        </div>

        <div class="consoleTelemetry" aria-label="Infrastructure telemetry">
          {valueCards[0].telemetry.map((item) => (
            <div class="telemetryCell" data-telemetry-cell style={`--level: ${item.level}%`}>
              <span>{item.label}</span>
              <strong>{item.value}</strong>
              <i aria-hidden="true"></i>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="service-journey" class="pathSection">
    <div class="container">
      <div class="sectionHead compact">
        <div class="eyebrow">Service journey</div>
        <h2>From need to installed system.</h2>
        <p>
          The quote flow is framed as a technical path: the customer describes the
          space, ARCWAVE maps the system, and the response becomes an installable brief.
        </p>
      </div>

      <div class="pathStage">
        <div class="pathRoute" aria-hidden="true"></div>
        <div class="pathGrid">
          {process.map((item) => (
            <article class="pathItem">
              <span>{item.step}</span>
              <dl>
                <div>
                  <dt>Input</dt>
                  <dd>{item.input}</dd>
                </div>
                <div>
                  <dt>Output</dt>
                  <dd>{item.output}</dd>
                </div>
              </dl>
              <ul>
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="featured-services" class="featuredSection">
    <div class="container">
      <div class="sectionHead compact">
        <div class="eyebrow">Featured service paths</div>
        <h2>High-impact systems for modern spaces.</h2>
      </div>

      <div class="featuredGrid">
        {featuredServices.map((service, index) => (
          <a class={`featuredCard f${index + 1}`} href={`/services/${service.key}`} data-vt="1">
            <img src={service.cardImage} alt="" loading="lazy" decoding="async" />
            <div>
              <small>{String(index + 1).padStart(2, "0")} / Service path</small>
              <span>{service.title}</span>
              <p>{service.short}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="technical-request" class="quoteFlowSection">
    <div class="container quoteFlowGrid">
      <div class="quoteFlowCopy">
        <div class="eyebrow">Technical request interface</div>
        <h2>Turn a loose need into a clear install brief.</h2>
        <p>
          Select the system path, describe the space and constraints, then open the
          full quote form or send a concise technical brief directly.
        </p>
      </div>

      <form class="quoteInterface" data-quote-interface data-quote-email={COMPANY.email}>
        <div class="quoteProgress" aria-label="Quote flow steps">
          <span class="isActive">01 Signal</span>
          <i></i>
          <span>02 Space</span>
          <i></i>
          <span>03 Constraints</span>
          <i></i>
          <span>04 Brief</span>
        </div>

        <div class="quoteWorkspace">
          <div class="quotePanel">
            <div class="quoteGroup">
              <div>
                <span class="quoteKicker">Service path</span>
                <strong>What should ARCWAVE map first?</strong>
              </div>

              <div class="quoteServiceGrid">
                {systemNodes.map((node, index) => (
                  <label>
                    <input
                      type="radio"
                      name="service"
                      value={node.label}
                      checked={index === 1}
                      data-quote-field="service"
                    />
                    <span>{String(index + 1).padStart(2, "0")}</span>
                    <strong>{node.label}</strong>
                    <em>{node.signal}</em>
                  </label>
                ))}
              </div>
            </div>

            <div class="quoteSplit">
              <label class="quoteSelect">
                <span>Space type</span>
                <select name="space" data-quote-field="space">
                  {quoteSpaceTypes.map((item) => <option value={item}>{item}</option>)}
                </select>
              </label>

              <label class="quoteSelect">
                <span>Timing</span>
                <select name="timeline" data-quote-field="timeline">
                  {quoteTimelines.map((item) => <option value={item}>{item}</option>)}
                </select>
              </label>
            </div>

            <div class="quoteGroup">
              <div>
                <span class="quoteKicker">Known constraints</span>
                <strong>What should be considered before quoting?</strong>
              </div>

              <div class="constraintGrid">
                {quoteConstraints.map((item, index) => (
                  <label>
                    <input
                      type="checkbox"
                      value={item}
                      checked={index === 2 || index === 5}
                      data-quote-field="constraint"
                    />
                    <span>{item}</span>
                  </label>
                ))}
              </div>
            </div>

            <label class="quoteText">
              <span>Space notes</span>
              <textarea
                name="notes"
                rows="4"
                data-quote-field="notes"
                placeholder="Example: apartment in Barcelona, provider handoff near entrance, need stable Wi-Fi and clean cable routing."
              ></textarea>
            </label>
          </div>

          <aside class="briefPanel" aria-label="Generated technical brief">
            <div class="briefStatus">
              <span>Live brief</span>
              <strong data-quote-status>Ready for technical review</strong>
            </div>

            <div class="briefPath" aria-hidden="true">
              <span>Signal</span>
              <i></i>
              <span>System</span>
              <i></i>
              <span>Quote</span>
            </div>

            <dl class="briefList">
              <div>
                <dt>Service</dt>
                <dd data-quote-output="service">Networks</dd>
              </div>
              <div>
                <dt>Space</dt>
                <dd data-quote-output="space">Apartment</dd>
              </div>
              <div>
                <dt>Timing</dt>
                <dd data-quote-output="timeline">Planning</dd>
              </div>
              <div>
                <dt>Constraints</dt>
                <dd data-quote-output="constraints">Provider handoff, Barcelona area</dd>
              </div>
            </dl>

            <p data-quote-output="notes">
              Add a short note to turn this into a cleaner technical request.
            </p>

            <div class="briefActions">
              <a class="primary" href="/contact#quote" data-quote-mailto data-vt="1">Send technical brief</a>
              <a class="secondary" href="/contact#quote" data-vt="1">Open full form</a>
            </div>
          </aside>
        </div>
      </form>
    </div>
  </section>
  </div>

  <script>
    function initHomeV2FieldFocus() {
      const root = document.querySelector(".homeV2");
      if (!root || root.getAttribute("data-focus-ready") === "true") return;

      root.setAttribute("data-focus-ready", "true");

      const focusControls = document.querySelectorAll("[data-field-focus]");
      const focusSteps = document.querySelectorAll("[data-scroll-focus]");

      function setFieldFocus(key) {
        if (!key) return;

        window.dispatchEvent(
          new CustomEvent("arcwave:field-focus", {
            detail: { key },
          })
        );

        [...focusControls, ...focusSteps].forEach((item) => {
          const itemKey = item.getAttribute("data-field-focus") || item.getAttribute("data-scroll-focus");
          item.classList.toggle("isActive", itemKey === key);
        });
      }

      focusControls.forEach((control) => {
        const key = control.getAttribute("data-field-focus");
        control.addEventListener("mouseenter", () => setFieldFocus(key));
        control.addEventListener("focus", () => setFieldFocus(key));
        control.addEventListener("click", () => setFieldFocus(key));
      });

      const observer = new IntersectionObserver(
        (entries) => {
          const active = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (active?.target) {
            setFieldFocus(active.target.getAttribute("data-scroll-focus"));
          }
        },
        {
          rootMargin: "-42% 0px -42% 0px",
          threshold: [0.16, 0.32, 0.52],
        }
      );

      focusSteps.forEach((step) => observer.observe(step));

      const systemMap = document.querySelector(".systemMap");
      const systemNodes = document.querySelectorAll("[data-system-node]");

      if (systemMap && systemMap.getAttribute("data-map-ready") !== "true") {
        systemMap.setAttribute("data-map-ready", "true");

        const cycle = ["telecom", "networks", "electricity", "alarms", "ev", "audio"];
        let index = 0;
        let autoCycle = null;

        function setSystemFocus(key) {
          if (!key || key === "system") return;
          systemMap.setAttribute("data-active-system", key);

          systemNodes.forEach((node) => {
            node.classList.toggle("isActive", node.getAttribute("data-system-node") === key);
          });
        }

        systemNodes.forEach((node) => {
          const key = node.getAttribute("data-system-node");
          node.addEventListener("mouseenter", () => setSystemFocus(key));
          node.addEventListener("focus", () => setSystemFocus(key));
        });

        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!prefersReducedMotion) {
          autoCycle = window.setInterval(() => {
            index = (index + 1) % cycle.length;
            setSystemFocus(cycle[index]);
          }, 2600);

          systemMap.addEventListener("mouseenter", () => {
            if (autoCycle) window.clearInterval(autoCycle);
          });

          systemMap.addEventListener("mouseleave", () => {
            autoCycle = window.setInterval(() => {
              index = (index + 1) % cycle.length;
              setSystemFocus(cycle[index]);
            }, 2600);
          });
        }

        setSystemFocus("telecom");
      }

      setFieldFocus("telecom");
    }

    function initQuoteInterface() {
      const form = document.querySelector("[data-quote-interface]");
      if (!form || form.getAttribute("data-quote-ready") === "true") return;

      form.setAttribute("data-quote-ready", "true");

      const mailto = form.querySelector("[data-quote-mailto]");
      const fallbackEmail = form.getAttribute("data-quote-email") || "hello@example.com";
      const outputs = {
        service: form.querySelector('[data-quote-output="service"]'),
        space: form.querySelector('[data-quote-output="space"]'),
        timeline: form.querySelector('[data-quote-output="timeline"]'),
        constraints: form.querySelector('[data-quote-output="constraints"]'),
        notes: form.querySelector('[data-quote-output="notes"]'),
      };

      function selectedRadio(name) {
        return form.querySelector(`input[name="${name}"]:checked`)?.value || "";
      }

      function selectedConstraints() {
        return [...form.querySelectorAll('[data-quote-field="constraint"]:checked')].map((item) => item.value);
      }

      function updateBrief() {
        const service = selectedRadio("service") || "Networks";
        const space = form.querySelector('[data-quote-field="space"]')?.value || "Apartment";
        const timeline = form.querySelector('[data-quote-field="timeline"]')?.value || "Planning";
        const constraints = selectedConstraints();
        const notes = form.querySelector('[data-quote-field="notes"]')?.value.trim() || "";

        outputs.service.textContent = service;
        outputs.space.textContent = space;
        outputs.timeline.textContent = timeline;
        outputs.constraints.textContent = constraints.length ? constraints.join(", ") : "No constraints selected";
        outputs.notes.textContent = notes || "Add a short note to turn this into a cleaner technical request.";

        form.querySelectorAll(".quoteServiceGrid label").forEach((label) => {
          label.classList.toggle("isSelected", label.querySelector("input")?.checked);
        });

        form.querySelectorAll(".constraintGrid label").forEach((label) => {
          label.classList.toggle("isSelected", label.querySelector("input")?.checked);
        });

        if (mailto) {
          const subject = `ARCWAVE technical request - ${service}`;
          const body = [
            "ARCWAVE technical request",
            "",
            `Service path: ${service}`,
            `Space type: ${space}`,
            `Timing: ${timeline}`,
            `Known constraints: ${constraints.length ? constraints.join(", ") : "None selected"}`,
            "",
            "Space notes:",
            notes || "No notes added yet.",
          ].join("\n");

          mailto.setAttribute(
            "href",
            `mailto:${encodeURIComponent(fallbackEmail)}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
          );
        }
      }

      form.addEventListener("input", updateBrief);
      form.addEventListener("change", updateBrief);
      form.addEventListener("submit", (event) => event.preventDefault());
      updateBrief();
    }

    function initPageNavigation() {
      const nav = document.querySelector("[data-page-nav]");
      if (!nav || nav.getAttribute("data-page-nav-ready") === "true") return;

      nav.setAttribute("data-page-nav-ready", "true");

      const links = [...nav.querySelectorAll("[data-page-nav-link]")];
      const progress = nav.querySelector("[data-page-progress]");
      const sections = links
        .map((link) => document.querySelector(link.getAttribute("href")))
        .filter(Boolean);

      function setActive(id) {
        links.forEach((link) => {
          const isActive = link.getAttribute("href") === `#${id}`;
          link.classList.toggle("isActive", isActive);
          if (isActive) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
      }

      links.forEach((link) => {
        link.addEventListener("click", () => {
          const id = link.getAttribute("href")?.slice(1);
          if (id) setActive(id);
        });
      });

      const observer = new IntersectionObserver(
        (entries) => {
          const active = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (active?.target?.id) setActive(active.target.id);
        },
        {
          rootMargin: "-38% 0px -48% 0px",
          threshold: [0.05, 0.16, 0.32, 0.5],
        }
      );

      sections.forEach((section) => observer.observe(section));

      let ticking = false;

      function updateProgress() {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const value = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        if (progress) progress.style.setProperty("--page-progress", value.toFixed(4));
        ticking = false;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateProgress);
          }
        },
        { passive: true }
      );

      setActive(sections[0]?.id || "signal-field");
      updateProgress();
    }

    function initValueConsole() {
      const consoleEl = document.querySelector("[data-value-console]");
      if (!consoleEl || consoleEl.getAttribute("data-value-console-ready") === "true") return;

      consoleEl.setAttribute("data-value-console-ready", "true");

      const tabs = [...consoleEl.querySelectorAll("[data-value-tab]")];
      const titleEl = consoleEl.querySelector("[data-console-title]");
      const textEl = consoleEl.querySelector("[data-console-text]");
      const stepEl = consoleEl.querySelector("[data-console-step]");
      const signalEl = consoleEl.querySelector("[data-console-signal]");
      const outcomeEl = consoleEl.querySelector("[data-console-outcome]");
      const pointsEl = consoleEl.querySelector("[data-console-points]");
      const traceEl = consoleEl.querySelector("[data-scope-trace]");
      const orbitEl = consoleEl.querySelector("[data-scope-orbit]");
      const scoreEl = consoleEl.querySelector("[data-console-score]");
      const scoreLabelEl = consoleEl.querySelector("[data-console-score-label]");
      const metricEls = [...consoleEl.querySelectorAll("[data-console-metric]")];
      const telemetryEls = [...consoleEl.querySelectorAll("[data-telemetry-cell]")];

      let typingTimer = 0;
      let autoTimer = 0;
      let activeIndex = 0;

      function parseDatasetList(value) {
        try {
          return JSON.parse(value || "[]");
        } catch {
          return [];
        }
      }

      function setMetricCards(items) {
        metricEls.forEach((metric, index) => {
          const item = items[index];
          if (!item) return;

          metric.querySelector("span").textContent = item.label || "";
          metric.querySelector("strong").textContent = item.value || "";
          metric.style.setProperty("--level", `${Number(item.level || 0)}%`);
        });
      }

      function setTelemetry(items) {
        telemetryEls.forEach((cell, index) => {
          const item = items[index];
          if (!item) return;

          cell.querySelector("span").textContent = item.label || "";
          cell.querySelector("strong").textContent = item.value || "";
          cell.style.setProperty("--level", `${Number(item.level || 0)}%`);
        });
      }

      function setText(target, value) {
        window.clearInterval(typingTimer);
        target.textContent = value;
        target.classList.remove("isUpdating");
        target.getBoundingClientRect();
        target.classList.add("isUpdating");
      }

      function activate(index, userIntent = false) {
        const tab = tabs[index];
        if (!tab) return;

        activeIndex = index;

        tabs.forEach((item, itemIndex) => {
          const isActive = itemIndex === index;
          item.classList.toggle("isActive", isActive);
          item.setAttribute("aria-selected", String(isActive));
        });

        consoleEl.setAttribute("data-console-active", String(index + 1));
        consoleEl.style.setProperty("--console-accent", tab.dataset.accent || "10 132 255");

        if (stepEl) stepEl.textContent = tab.querySelector("span")?.textContent || "";
        if (titleEl) titleEl.textContent = tab.dataset.title || "";
        if (signalEl) signalEl.textContent = tab.dataset.signal || "";
        if (outcomeEl) outcomeEl.textContent = tab.dataset.outcome || "";
        if (scoreEl) scoreEl.textContent = tab.dataset.score || "";
        if (scoreLabelEl) scoreLabelEl.textContent = tab.dataset.scoreLabel || "";
        if (textEl) setText(textEl, tab.dataset.text || "");
        setMetricCards(parseDatasetList(tab.dataset.metrics));
        setTelemetry(parseDatasetList(tab.dataset.telemetry));

        if (pointsEl) {
          pointsEl.innerHTML = "";
          (tab.dataset.points || "")
            .split("|")
            .filter(Boolean)
            .forEach((point) => {
              const li = document.createElement("li");
              li.textContent = point;
              pointsEl.append(li);
            });
        }

        if (traceEl) {
          if (tab.dataset.path) traceEl.setAttribute("d", tab.dataset.path);
          if (orbitEl && tab.dataset.path) orbitEl.setAttribute("d", tab.dataset.path);
          traceEl.classList.remove("isDrawing");
          traceEl.getBoundingClientRect();
          traceEl.classList.add("isDrawing");
        }

        if (userIntent) {
          window.clearInterval(autoTimer);
          autoTimer = window.setInterval(() => activate((activeIndex + 1) % tabs.length), 5200);
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => activate(index, true));
        tab.addEventListener("mouseenter", () => activate(index, true));
      });

      autoTimer = window.setInterval(() => activate((activeIndex + 1) % tabs.length), 5200);
      activate(0);
    }

    function initHomeV2Motion() {
      const root = document.querySelector(".homeV2");
      if (!root || root.getAttribute("data-motion-ready") === "true") return;

      root.setAttribute("data-motion-ready", "true");

      const revealTargets = root.querySelectorAll(
        [
          ".systemSection .sectionHead",
          ".systemMap",
          ".valueRibbon",
          ".valueCard",
          ".pathSection .sectionHead",
          ".pathStage",
          ".pathItem",
          ".featuredSection .sectionHead",
          ".featuredCard",
          ".quoteFlowCopy",
          ".quoteInterface",
          ".quotePanel",
          ".briefPanel",
        ].join(",")
      );

      revealTargets.forEach((item, index) => {
        item.classList.add("motionReveal");
        item.style.setProperty("--motion-index", String(index % 6));
      });

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (prefersReducedMotion) {
        revealTargets.forEach((item) => item.classList.add("isVisible"));
        return;
      }

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("isVisible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        {
          rootMargin: "0px 0px -14% 0px",
          threshold: [0.12, 0.28],
        }
      );

      revealTargets.forEach((item) => revealObserver.observe(item));

      function revealVisibleTargets() {
        revealTargets.forEach((item) => {
          if (item.classList.contains("isVisible")) return;

          const rect = item.getBoundingClientRect();
          const isVisible = rect.top < window.innerHeight * 0.92 && rect.bottom > window.innerHeight * 0.04;

          if (isVisible) {
            item.classList.add("isVisible");
            revealObserver.unobserve(item);
          }
        });
      }

      window.requestAnimationFrame(revealVisibleTargets);
      window.setTimeout(revealVisibleTargets, 180);
      window.setTimeout(revealVisibleTargets, 700);

      let ticking = false;

      function updateScrollMotion() {
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, window.scrollY / maxScroll));
        root.style.setProperty("--scroll-motion", progress.toFixed(4));
        root.style.setProperty("--scroll-drift", `${(progress * -72).toFixed(2)}px`);
        ticking = false;
      }

      window.addEventListener(
        "scroll",
        () => {
          if (!ticking) {
            ticking = true;
            window.requestAnimationFrame(updateScrollMotion);
          }
        },
        { passive: true }
      );

      updateScrollMotion();
    }

    initHomeV2FieldFocus();
    initValueConsole();
    initQuoteInterface();
    initPageNavigation();
    initHomeV2Motion();
    document.addEventListener("astro:page-load", () => {
      initHomeV2FieldFocus();
      initValueConsole();
      initQuoteInterface();
      initPageNavigation();
      initHomeV2Motion();
    });
  </script>

