      cursor:pointer;
      transition: color .2s ease, background .2s ease, transform .2s ease;
    }

    .consolePicker button:before{
      content:"";
      position:absolute;
      left: 0;
      top: 15px;
      bottom: 15px;
      width: 2px;
      border-radius:999px;
      background: rgba(15,15,20,.08);
      transition: background .2s ease, box-shadow .2s ease, transform .2s ease;
    }

    .consolePicker button:after{
      content:"";
      position:absolute;
      right: 10px;
      top: 12px;
      width: 6px;
      height: 6px;
      border-radius:999px;
      background: rgba(15,15,20,.16);
      box-shadow: 0 0 0 5px rgba(15,15,20,.035);
      transition: background .2s ease, box-shadow .2s ease;
    }

    .consolePicker button:hover,
    .consolePicker button:focus-visible,
    .consolePicker button.isActive{
      color: rgba(15,15,20,.92);
      background:
        radial-gradient(160px 90px at 100% 0%, rgb(var(--console-accent) / .105), transparent 70%),
        rgba(255,255,255,.42);
      outline:none;
      transform: translateX(1px);
    }

    .consolePicker button.isActive:before{
      background: rgb(var(--console-accent) / .82);
      box-shadow: 0 0 22px rgb(var(--console-accent) / .30);
      transform: scaleY(1.18);
    }

    .consolePicker button.isActive:after{
      background: rgb(var(--console-accent) / .88);
      box-shadow:
        0 0 0 7px rgb(var(--console-accent) / .10),
        0 0 26px rgb(var(--console-accent) / .28);
    }

    .consolePicker button span{
      color: rgb(var(--console-accent) / .78);
      font-size: 10px;
      letter-spacing:.16em;
      text-transform:uppercase;
      font-weight: 780;
    }

    .consolePicker strong{
      max-width: 11ch;
      font-size: 13px;
      line-height:1.12;
      letter-spacing:-.01em;
    }

    .consolePicker em{
      max-width: 13ch;
      color: rgba(15,15,20,.48);
      font-size: 11px;
      font-style:normal;
      line-height:1.3;
    }

    .consoleScope{
      display:grid;
      grid-template-rows: auto minmax(0, 1fr) auto;
      gap: clamp(16px, 2vw, 26px);
      padding: clamp(24px, 2.8vw, 46px);
      border-right: 1px solid rgba(15,15,20,.065);
      overflow:hidden;
    }

    .scopeTopline{
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap: 18px;
    }

    .scopeTopline strong{
      color: rgba(15,15,20,.76);
      font-size: 13px;
      letter-spacing:.02em;
    }

    .scopeCanvas{
      position:relative;
      min-height: 300px;
      overflow:hidden;
      border-top: 1px solid rgba(15,15,20,.055);
      border-bottom: 1px solid rgba(15,15,20,.055);
      background:
        linear-gradient(rgba(15,15,20,.024) 1px, transparent 1px),
        linear-gradient(90deg, rgba(15,15,20,.024) 1px, transparent 1px);
      background-size: 42px 42px;
      mask-image: linear-gradient(90deg, transparent, black 7%, black 93%, transparent);
    }

    .consoleScope svg{
      position:absolute;
      inset: 8px 0;
      width:100%;
      height: calc(100% - 16px);
      overflow:visible;
    }

    .scopeGridLine{
      fill:none;
      stroke: rgba(15,15,20,.052);
      stroke-width: 1;
    }

    .scopeBand{
      fill:none;
      stroke: rgba(15,15,20,.07);
      stroke-width: 1.4;
      stroke-dasharray: 12 16;
    }

    .scopeOrbit{
      fill:none;
      stroke: rgb(var(--console-accent) / .16);
      stroke-width: 8;
      stroke-linecap:round;
      opacity:.72;
      filter: blur(2px);
      transition: stroke .32s ease;
    }

    .scopeTrace{
      fill:none;
      stroke: url(#valueTraceGradient);
      stroke-width: 5.4;
      stroke-linecap:round;
      stroke-dasharray: 1180;
      stroke-dashoffset: 1180;
      filter: url(#valueGlow);
    }

    .scopeTrace.isDrawing{
      animation: traceDraw 1.28s cubic-bezier(.16, 1, .3, 1) forwards;
    }

    .scopeStations circle{
      fill: rgb(var(--console-accent) / .68);
      stroke: rgba(255,255,255,.92);
      stroke-width: 2;
      filter: drop-shadow(0 0 18px rgb(var(--console-accent) / .34));
      animation: stationPulse 3.6s ease-in-out infinite;
    }

    .scopeStations circle:nth-child(2){ animation-delay:-.8s; }
    .scopeStations circle:nth-child(3){ animation-delay:-1.6s; }
    .scopeStations circle:nth-child(4){ animation-delay:-2.4s; }

    .scopeScan{
      position:absolute;
      top: 8%;
      bottom: 8%;
      width: 28%;
      pointer-events:none;
      background: linear-gradient(90deg, transparent, rgb(var(--console-accent) / .13), transparent);
      mix-blend-mode:multiply;
      animation: scanSweep 6.8s cubic-bezier(.4,0,.2,1) infinite;
    }

    .scanDot{
      position:absolute;
      width: 10px;
      height: 10px;
      border-radius:999px;
      background: rgb(var(--console-accent) / .72);
      box-shadow:
        0 0 0 8px rgb(var(--console-accent) / .08),
        0 0 24px rgb(var(--console-accent) / .28);
      animation: scanFloat 5.2s ease-in-out infinite;
    }

    .scanDot.d1{ left: 18%; top: 38%; }
    .scanDot.d2{ left: 55%; top: 63%; animation-delay:-1.6s; }
    .scanDot.d3{ right: 18%; top: 32%; animation-delay:-3.1s; }

    .scopeMetricGrid{
      display:grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 14px;
    }

    .scopeMetric{
      min-width:0;
      padding-top: 12px;
      border-top: 1px solid rgb(var(--console-accent) / .20);
    }

    .scopeMetric strong{
      display:block;
      margin-top: 7px;
      color: rgba(15,15,20,.82);
      font-size: clamp(20px, 1.8vw, 30px);
      letter-spacing:-.035em;
    }

    .scopeMetric i,
    .telemetryCell i{
      position:relative;
      display:block;
      height: 3px;
      margin-top: 12px;
      overflow:hidden;
      border-radius:999px;
      background: rgba(15,15,20,.06);
    }

    .scopeMetric i:after,
    .telemetryCell i:after{
      content:"";
      position:absolute;
      inset:0 auto 0 0;
      width: var(--level, 0%);
      border-radius:inherit;
      background: linear-gradient(90deg, rgb(var(--console-accent) / .42), rgb(var(--console-accent) / .92));
      box-shadow: 0 0 18px rgb(var(--console-accent) / .22);
      transition: width .55s cubic-bezier(.16, 1, .3, 1);
    }

    .consoleReadout{
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      gap: 24px;
      padding: clamp(28px, 3.2vw, 58px);
      background:
        linear-gradient(180deg, rgba(255,255,255,.54), rgba(255,255,255,.26));
      backdrop-filter: blur(18px) saturate(1.06);
      -webkit-backdrop-filter: blur(18px) saturate(1.06);
