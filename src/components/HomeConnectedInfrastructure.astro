      max-width: 48ch;
      margin-top: 22px;
      color: rgba(15,15,20,.62);
      font-size: 15px;
      line-height:1.62;
    }

    .consoleReadout p.isUpdating{
      animation: readoutSwap .36s ease both;
    }

    .readoutScore{
      display:grid;
      grid-template-columns: auto 1fr;
      column-gap: 16px;
      row-gap: 4px;
      align-items:end;
      padding: 18px 0;
