    .impactStat{
      position:relative;
      min-width:0;
      width:100%;
      max-width: 270px;
      padding-top: 18px;
    }

    .impactStat:nth-child(2),
    .impactStat:nth-child(3){
      justify-self:center;
    }

    .impactStat:nth-child(4){
      justify-self:end;
    }

    .impactStat:before{
      content:"";
      position:absolute;
      left:0;
      top:-24px;
      width: 9px;
      height: 9px;
      border-radius:999px;
      background: rgba(10,132,255,.86);
      box-shadow:
        0 0 0 8px rgba(10,132,255,.08),
        0 0 28px rgba(10,132,255,.20);
      opacity:.55;
      transform: scale(.84);
      transition: opacity .42s ease, transform .42s ease, background .42s ease;
      transition-delay: calc(var(--impact-index, 0) * 80ms);
    }

    .impactStat:nth-child(2):before{
      background: rgba(39,182,173,.84);
      box-shadow:
        0 0 0 8px rgba(39,182,173,.08),
        0 0 28px rgba(39,182,173,.18);
    }

    .impactStat:nth-child(3):before{
      background: rgba(207,163,90,.84);
      box-shadow:
        0 0 0 8px rgba(207,163,90,.08),
        0 0 28px rgba(207,163,90,.18);
    }

    .impactStat:nth-child(4):before{
      background: rgba(119,143,208,.84);
      box-shadow:
        0 0 0 8px rgba(119,143,208,.08),
        0 0 28px rgba(119,143,208,.18);
    }

    .impactStat.isCounted:before{
      opacity:1;
      transform: scale(1);
    }

    .impactStat strong{
      display:block;
      overflow:hidden;
      color: rgba(15,15,20,.94);
      font-size: clamp(48px, 5.7vw, 104px);
      line-height:.82;
      letter-spacing:0;
      font-weight: 820;
      font-variant-numeric: tabular-nums;
