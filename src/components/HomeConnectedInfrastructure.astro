    .mapBeacons .b1{ left: 25%; top: 35%; animation-delay: -.8s; }
    .mapBeacons .b2{ right: 26%; top: 28%; background: rgba(205,158,60,.72); box-shadow: 0 0 0 9px rgba(205,158,60,.08), 0 0 28px rgba(205,158,60,.20); animation-delay: -2s; }
    .mapBeacons .b3{ right: 30%; bottom: 28%; animation-delay: -3.4s; }
    .mapBeacons .b4{ left: 34%; bottom: 24%; background: rgba(35,198,190,.58); box-shadow: 0 0 0 9px rgba(35,198,190,.07), 0 0 28px rgba(35,198,190,.18); animation-delay: -4.8s; }

    @keyframes routeTravel{
      0%{ transform: translateX(-25%); opacity:0; }
      18%{ opacity:1; }
      72%{ opacity:1; }
      100%{ transform: translateX(565%); opacity:0; }
    }

    @keyframes flowDash{
      to{ stroke-dashoffset: -120; }
    }

    @keyframes orbitDrift{
      to{ transform: rotate(360deg); }
    }

    @keyframes beaconFloat{
      0%, 100%{ transform: translate3d(0,0,0) scale(.82); opacity:.42; }
      45%{ transform: translate3d(18px,-12px,0) scale(1.18); opacity:.95; }
