      height: 1px;
      margin-bottom: clamp(18px, 2vw, 30px);
      overflow:hidden;
      background: rgba(30,44,60,.08);
    }

    .impactLine span{
      position:absolute;
      inset:0 auto 0 0;
      width: 0%;
      background: linear-gradient(90deg, rgba(10,132,255,.88), rgba(39,182,173,.52), rgba(207,163,90,.34), transparent);
      transition: width 1.4s cubic-bezier(.16, 1, .3, 1);
