      right: 22px;
      bottom: 22px;
    }

    .scopeHudCard span{
      color: rgba(30,44,60,.46);
      font-size: 9.5px;
      font-weight: 780;
      text-transform:uppercase;
    }

    .scopeHudCard strong{
      color: rgba(30,44,60,.78);
      font-size: 13px;
      line-height:1;
    }

    .scopeHudCard i{
      position:relative;
      display:block;
      height: 2px;
      overflow:hidden;
      border-radius:999px;
      background: rgba(30,44,60,.075);
    }

    .scopeHudCard i:after{
      content:"";
      position:absolute;
      inset:0 auto 0 0;
      width: 72%;
      border-radius:inherit;
      background: linear-gradient(90deg, rgb(var(--console-accent) / .35), rgb(var(--console-accent) / .92));
      animation: hudMeter 4.4s ease-in-out infinite;
    }

    .scopePacketRail{
      position:absolute;
      left: 13%;
      right: 13%;
      bottom: 18px;
      z-index:4;
      height: 1px;
      background: rgba(30,44,60,.075);
      overflow:hidden;
    }

    .scopePacketRail span{
      position:absolute;
      top:0;
      width: 16%;
      height:100%;
      border-radius:999px;
      background: linear-gradient(90deg, transparent, rgb(var(--console-accent) / .9), transparent);
      animation: packetRun 3.8s linear infinite;
    }

    .scopePacketRail span:nth-child(2){
      animation-delay:-1.25s;
      width: 11%;
    }

    .scopePacketRail span:nth-child(3){
      animation-delay:-2.5s;
      width: 8%;
    }

    @keyframes traceDraw{
      to{ stroke-dashoffset: 0; }
    }

    @keyframes scanSweep{
      0%{ transform: translateX(-110%); opacity:0; }
      12%, 72%{ opacity:1; }
      100%{ transform: translateX(390%); opacity:0; }
    }

    @keyframes scanFloat{
      0%,100%{ transform: translate3d(0,0,0) scale(.88); opacity:.58; }
      50%{ transform: translate3d(18px,-12px,0) scale(1.12); opacity:1; }
    }

    @keyframes stationPulse{
      0%,100%{ opacity:.54; transform: scale(.92); }
      48%{ opacity:1; transform: scale(1.18); }
    }

    @keyframes readoutSwap{
      from{ opacity:.35; transform: translateY(6px); filter: blur(4px); }
      to{ opacity:1; transform: translateY(0); filter: blur(0); }
    }

    @keyframes pointIn{
      from{ opacity:0; transform: translateY(5px); }
      to{ opacity:1; transform: translateY(0); }
    }

    @keyframes laneDrift{
      to{ stroke-dashoffset: -96; }
    }

    @keyframes dataNodePulse{
      0%,100%{ opacity:.38; transform: scale(.92); }
      46%{ opacity:.88; transform: scale(1.16); }
    }

    @keyframes hudMeter{
      0%,100%{ width: 54%; opacity:.68; }
      48%{ width: 88%; opacity:1; }
    }

    @keyframes packetRun{
      from{ transform: translateX(-120%); opacity:0; }
      12%,82%{ opacity:1; }
      to{ transform: translateX(720%); opacity:0; }
    }

