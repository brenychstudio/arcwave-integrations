      text-shadow: 0 0 34px rgb(var(--console-accent) / .18);
    }

    .readoutScore em{
      color: rgba(15,15,20,.54);
      font-style:normal;
      font-size: 13px;
      line-height:1.35;
    }

    .consolePoints{
      display:grid;
      gap: 10px;
      margin:0;
      padding:0;
      list-style:none;
    }

    .consolePoints li{
      position:relative;
      padding-left: 18px;
      color: rgba(15,15,20,.64);
      font-size: 13px;
      line-height:1.42;
      animation: pointIn .32s ease both;
    }

    .consolePoints li:before{
      content:"";
      position:absolute;
      left:0;
      top:.58em;
      width: 6px;
      height: 6px;
      border-radius:999px;
      background: rgb(var(--console-accent) / .72);
      box-shadow: 0 0 0 4px rgb(var(--console-accent) / .08);
      transform: translateY(-50%);
    }

    .consoleTelemetry{
      grid-column: 2 / 4;
      display:grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 1px;
      border-top: 1px solid rgba(15,15,20,.07);
      background: rgba(15,15,20,.055);
    }

    .telemetryCell{
      min-width:0;
      padding: 18px 18px 16px;
      background: rgba(255,255,255,.42);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
