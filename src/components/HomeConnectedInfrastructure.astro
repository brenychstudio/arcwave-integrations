      border-radius: 20px;
      background: rgba(30,44,60,.06);
    }

    :global(.logicReadout dl div){
      display:grid;
      grid-template-columns: 96px minmax(0, 1fr);
      gap: 14px;
      padding: 14px;
      background: rgba(255,255,255,.58);
