    :global(.logicClarified){
      grid-column: 2 / 4;
      display:grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1px;
      border-top: 1px solid rgba(30,44,60,.075);
      background: rgba(30,44,60,.055);
    }

