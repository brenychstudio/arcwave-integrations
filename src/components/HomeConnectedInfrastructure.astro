    .valueRibbon:before{
      background:
        linear-gradient(90deg, rgba(255,255,255,.82) 0%, rgba(255,255,255,.22) 32%, rgba(250,253,255,.62) 100%),
        linear-gradient(124deg, transparent 0 32%, rgba(30,44,60,.065) 32.08%, transparent 32.22%),
        linear-gradient(20deg, transparent 0 64%, rgb(var(--console-accent) / .10) 64.08%, transparent 64.28%),
        radial-gradient(720px 320px at 72% 18%, rgb(var(--console-accent) / .105), transparent 70%);
      opacity:.96;
