    .consoleScope svg{
      inset: 0;
      height:100%;
      z-index:1;
    }

    .scopePlot{
      fill: rgba(255,255,255,.12);
      stroke: rgba(30,44,60,.055);
      stroke-width: 1;
    }

    .scopeGridLine{
      stroke: rgba(30,44,60,.052);
    }

    .scopeStageGates path{
      fill:none;
      stroke: url(#valueGateGradient);
      stroke-width: 1;
      stroke-dasharray: 4 10;
    }

    .scopeDependencyLanes path{
