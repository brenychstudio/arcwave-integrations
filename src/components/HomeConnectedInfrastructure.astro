---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignalInfrastructureField from "./SignalInfrastructureField";
import { services } from "../content/services";
import { servicesEs } from "../content/services.es";
import { COMPANY, hasRealEmail } from "../content/company";

type PageProps = {
  title?: string;
  description?: string;
  noindex?: boolean;
  locale?: "en" | "es";
};

const incomingProps = Astro.props as PageProps;
const locale = incomingProps.locale === "es" ? "es" : "en";
const isEs = locale === "es";
const basePath = isEs ? "/es" : "";
const activeServices = isEs ? servicesEs : services;
const contactHref = `${basePath}/contact#quote`;
const servicesHref = `${basePath}/services`;

const layoutTitle =
  incomingProps.title ??
  (isEs ? "Connected Infrastructure OS para espacios modernos" : "Connected Infrastructure OS for Modern Spaces");
const layoutDescription =
  incomingProps.description ??
  (isEs
    ? "ARCWAVE diseña e integra telecomunicaciones, redes, electricidad, smart home, carga VE, seguridad y audio como una capa técnica fiable."
    : "ARCWAVE designs and integrates telecom, networks, electricity, smart home, EV charging, security and audio systems as one reliable technical layer.");
const layoutNoindex = incomingProps.noindex ?? false;

const copy = isEs
  ? {
      navAria: "Navegación de secciones de Home",
      conceptLabel: "Connected Infrastructure",
      heroTitle: "Infraestructura invisible, integrada con precisión.",
      heroLead:
        "Telecomunicaciones, redes, electricidad, smart home, carga VE, seguridad y audio, planificados como una capa técnica fiable para espacios modernos.",
      quoteCta: "Solicitar presupuesto",
      servicesCta: "Explorar servicios",
      formula: ["señal", "sistema", "ruta de servicio", "prueba", "presupuesto"],
      focusAria: "Ruta de enfoque de infraestructura",
      signalStageAria: "Campo de infraestructura de señal",
      stageCaption: "Campo de infraestructura de señal",
      stageCaptionSmall: "Capa de topología viva",
      systemEyebrow: "Mapa de servicios conectados",
      systemTitle: "Una capa técnica. Seis rutas de servicio conectadas.",
      systemText:
        "ARCWAVE presenta la infraestructura como un sistema integrado: señal, energía, seguridad, confort y audio, diseñados para trabajar juntos.",
      mapHud: "Topología de servicio viva",
      mapCoreTop: "Integrado",
      mapCoreMain: "Sistema",
      impactAria: "Impacto de proyectos ARCWAVE",
      impactLabel: "Señales de entrega",
      impactText:
        "Instalaciones, alcances activos y conversaciones técnicas tempranas muestran cómo ARCWAVE convierte necesidades dispersas en entrega coordinada.",
      journeyEyebrow: "Service journey",
      journeyTitle: "De necesidad a sistema instalado.",
      journeyText:
        "El flujo de presupuesto se plantea como una ruta técnica: el cliente describe el espacio, ARCWAVE mapea el sistema y la respuesta se convierte en un brief instalable.",
      inputLabel: "Input",
      outputLabel: "Output",
      featuredEyebrow: "Rutas de servicio destacadas",
      featuredTitle: "Sistemas de alto impacto para espacios modernos.",
      servicePathLabel: "Ruta de servicio",
      requestEyebrow: "Interfaz de solicitud técnica",
      requestTitle: "Convierte una necesidad abierta en un brief instalable.",
      requestText:
        "Selecciona la ruta del sistema, describe el espacio y las restricciones, y abre el formulario completo o prepara un brief técnico conciso.",
      quoteProgress: ["01 Señal", "02 Espacio", "03 Restricciones", "04 Brief"],
      servicePathKicker: "Ruta de servicio",
      serviceQuestion: "¿Qué debería mapear ARCWAVE primero?",
      spaceTypeLabel: "Tipo de espacio",
      timingLabel: "Plazo",
      constraintsKicker: "Restricciones conocidas",
      constraintsQuestion: "¿Qué debe considerarse antes de presupuestar?",
      notesLabel: "Notas del espacio",
      notesPlaceholder:
        "Ejemplo: piso en Barcelona, entrada de operador cerca del acceso, necesito Wi-Fi estable y recorrido de cable limpio.",
      liveBrief: "Brief vivo",
      briefReady: "Listo para revisión técnica",
      briefPath: ["Señal", "Sistema", "Presupuesto"],
      briefLabels: {
        service: "Servicio",
        space: "Espacio",
        timing: "Plazo",
        constraints: "Restricciones",
      },
      defaultService: "Redes",
      defaultSpace: "Piso",
      defaultTiming: "Planificación",
      defaultConstraints: "Entrada de operador, Barcelona",
      defaultNotes: "Añade una nota breve para convertirlo en una solicitud técnica más clara.",
      sendBrief: "Enviar brief técnico",
      openForm: "Abrir formulario",
      mailSubjectPrefix: "Solicitud técnica ARCWAVE",
      mailBodyLabels: {
        service: "Ruta de servicio",
        space: "Espacio",
        timing: "Plazo",
        constraints: "Restricciones",
        notes: "Notas",
      },
      pageNavItems: [
        { href: "#signal-field", index: "01", label: "Señal" },
        { href: "#system-map", index: "02", label: "Sistema" },
        { href: "#service-journey", index: "03", label: "Ruta" },
        { href: "#featured-services", index: "04", label: "Servicios" },
        { href: "#technical-request", index: "05", label: "Presupuesto" },
      ],
    }
  : {
      navAria: "Home section navigation",
      conceptLabel: "Connected Infrastructure",
      heroTitle: "Invisible infrastructure, precisely integrated.",
      heroLead:
        "Telecom, networks, electricity, smart home, EV charging, security and audio systems - planned as one reliable technical layer for modern spaces.",
      quoteCta: "Request a quote",
      servicesCta: "Explore services",
      formula: ["signal", "system", "service path", "proof", "quote"],
      focusAria: "Infrastructure focus path",
      signalStageAria: "Signal Infrastructure Field",
      stageCaption: "Signal Infrastructure Field",
      stageCaptionSmall: "Live topology layer",
      systemEyebrow: "Connected services map",
      systemTitle: "One technical layer. Six connected service paths.",
      systemText:
        "ARCWAVE presents infrastructure as an integrated system: signal, power, security, comfort and audio - designed to work together.",
      mapHud: "Live service topology",
      mapCoreTop: "Integrated",
      mapCoreMain: "System",
      impactAria: "ARCWAVE project impact",
      impactLabel: "Delivery signals",
      impactText:
        "Installed systems, active scopes and early technical conversations show how ARCWAVE turns scattered infrastructure needs into coordinated delivery.",
      journeyEyebrow: "Service journey",
      journeyTitle: "From need to installed system.",
      journeyText:
        "The quote flow is framed as a technical path: the customer describes the space, ARCWAVE maps the system, and the response becomes an installable brief.",
      inputLabel: "Input",
      outputLabel: "Output",
      featuredEyebrow: "Featured service paths",
      featuredTitle: "High-impact systems for modern spaces.",
      servicePathLabel: "Service path",
      requestEyebrow: "Technical request interface",
      requestTitle: "Turn a loose need into a clear install brief.",
      requestText:
        "Select the system path, describe the space and constraints, then open the full quote form or send a concise technical brief directly.",
      quoteProgress: ["01 Signal", "02 Space", "03 Constraints", "04 Brief"],
      servicePathKicker: "Service path",
      serviceQuestion: "What should ARCWAVE map first?",
      spaceTypeLabel: "Space type",
      timingLabel: "Timing",
      constraintsKicker: "Known constraints",
      constraintsQuestion: "What should be considered before quoting?",
      notesLabel: "Space notes",
      notesPlaceholder:
        "Example: apartment in Barcelona, provider handoff near entrance, need stable Wi-Fi and clean cable routing.",
      liveBrief: "Live brief",
      briefReady: "Ready for technical review",
      briefPath: ["Signal", "System", "Quote"],
      briefLabels: {
        service: "Service",
        space: "Space",
        timing: "Timing",
        constraints: "Constraints",
      },
      defaultService: "Networks",
      defaultSpace: "Apartment",
      defaultTiming: "Planning",
      defaultConstraints: "Provider handoff, Barcelona area",
      defaultNotes: "Add a short note to turn this into a cleaner technical request.",
      sendBrief: "Send technical brief",
      openForm: "Open full form",
      mailSubjectPrefix: "ARCWAVE technical request",
      mailBodyLabels: {
        service: "Service path",
        space: "Space",
        timing: "Timing",
        constraints: "Constraints",
        notes: "Notes",
      },
      pageNavItems: [
        { href: "#signal-field", index: "01", label: "Signal" },
        { href: "#system-map", index: "02", label: "System" },
        { href: "#service-journey", index: "03", label: "Path" },
        { href: "#featured-services", index: "04", label: "Services" },
        { href: "#technical-request", index: "05", label: "Quote" },
      ],
    };

const featuredServices = activeServices.filter((service) =>
  ["networks", "electricity", "alarms"].includes(service.key)
);

const systemNodes = isEs
  ? [
      { key: "telecom", label: "Telecom", signal: "Señal principal", note: "Líneas, terminaciones, handoff de operador" },
      { key: "networks", label: "Redes", signal: "Conectividad estable", note: "Wi-Fi, puntos de acceso, topología" },
      { key: "electricity", label: "Electricidad", signal: "Energía + control", note: "Cuadros, circuitos, cableado smart-ready" },
      { key: "ev", label: "Carga VE", signal: "Entrega de energía", note: "Puntos de carga y recorrido seguro" },
      { key: "alarms", label: "Seguridad", signal: "Perímetro protegido", note: "Alarmas, CCTV, zonas, monitorización" },
      { key: "audio", label: "Audio", signal: "Campo sonoro", note: "Cine en casa, multiroom, audio para locales" },
    ]
  : [
      { key: "telecom", label: "Telecom", signal: "Long-distance signal", note: "Lines, terminations, provider handoff" },
      { key: "networks", label: "Networks", signal: "Stable connectivity", note: "Wi-Fi, access points, topology" },
      { key: "electricity", label: "Electricity", signal: "Power + control", note: "Panels, circuits, smart-ready wiring" },
      { key: "ev", label: "EV Charging", signal: "Energy delivery", note: "Charging points and safe routing" },
      { key: "alarms", label: "Security", signal: "Protected perimeter", note: "Alarms, CCTV, zones, monitoring-ready" },
      { key: "audio", label: "Audio", signal: "Sound field", note: "Home cinema, multiroom, venue audio" },
    ];

const process = isEs
  ? [
      {
        step: "01",
        title: "Señal",
        text: "La necesidad se identifica: conectividad, energía, seguridad, confort o audio.",
        input: "Necesidad / problema",
        output: "Señal inicial",
        details: ["Categoría de servicio", "Tipo de espacio", "Punto principal"],
      },
      {
        step: "02",
        title: "Sistema",
        text: "Los servicios se mapean como una capa técnica, no como tareas aisladas.",
        input: "Mezcla de servicios",
        output: "Vista del sistema",
        details: ["Red + energía", "Seguridad / confort", "Accesos"],
      },
      {
        step: "03",
        title: "Ruta de servicio",
        text: "Alcance, restricciones, ruta de instalación y entrega quedan claros.",
        input: "Restricciones del sitio",
        output: "Ruta instalable",
        details: ["Rutas y distancias", "Cuadro / rack", "Restricciones del edificio"],
      },
      {
        step: "04",
        title: "Prueba",
        text: "Claridad técnica, diagramas, notas de handoff y estructura de servicio generan confianza.",
        input: "Plan técnico",
        output: "Paquete de claridad",
        details: ["Etiquetas y notas", "Resultado esperado", "Entrega para soporte"],
      },
      {
        step: "05",
        title: "Presupuesto",
        text: "La solicitud se convierte en un brief técnico claro para el espacio.",
        input: "Alcance confirmado",
        output: "Brief técnico",
        details: ["Servicio seleccionado", "Notas del espacio", "Siguiente respuesta"],
      },
    ]
  : [
      {
        step: "01",
        title: "Signal",
        text: "The need is identified: connectivity, power, security, comfort or audio.",
        input: "Need / issue",
        output: "Initial signal",
        details: ["Service category", "Space type", "Main pain point"],
      },
      {
        step: "02",
        title: "System",
        text: "Services are mapped as one technical layer, not isolated tasks.",
        input: "Service mix",
        output: "System view",
        details: ["Network + power dependencies", "Security / comfort layers", "Access points"],
      },
      {
        step: "03",
        title: "Service path",
        text: "Scope, constraints, installation route and handover are clarified.",
        input: "Site constraints",
        output: "Install path",
        details: ["Routes and distances", "Panel / rack locations", "Building constraints"],
      },
      {
        step: "04",
        title: "Proof",
        text: "Technical clarity, diagrams, handoff notes and bilingual service structure build trust.",
        input: "Technical plan",
        output: "Clarity pack",
        details: ["Labels and notes", "Expected outcome", "Support-ready handover"],
      },
      {
        step: "05",
        title: "Quote",
        text: "The request becomes a clear technical brief for the space.",
        input: "Confirmed scope",
        output: "Quote brief",
        details: ["Selected service", "Space notes", "Next response"],
      },
    ];

const impactStats = isEs
  ? [
      { value: 124, suffix: "+", label: "instalaciones completadas", text: "Viviendas, oficinas y espacios de servicio pasados de solicitud a infraestructura funcional." },
      { value: 18, suffix: "", label: "alcances activos", text: "Solicitudes técnicas en aclaración, presupuesto o preparación de instalación." },
      { value: 360, suffix: "+", label: "consultas técnicas", text: "Conversaciones tempranas que convierten necesidades vagas en rutas claras." },
      { value: 6, suffix: "", label: "capas conectadas", text: "Telecom, redes, electricidad, carga VE, seguridad y audio planificados como un sistema." },
    ]
  : [
      { value: 124, suffix: "+", label: "completed installations", text: "Homes, offices and service spaces moved from request to working infrastructure." },
      { value: 18, suffix: "", label: "active scopes", text: "Technical requests currently being clarified, quoted or prepared for installation." },
      { value: 360, suffix: "+", label: "technical consultations", text: "Early calls and site conversations that turn vague needs into a clear path." },
      { value: 6, suffix: "", label: "connected service layers", text: "Telecom, networks, power, EV, security and audio planned as one system." },
    ];

const journeyFocus = isEs
  ? [
      { key: "telecom", step: "01", label: "Telecom", title: "La señal entra en el espacio", text: "Handoff de operador, fibra/cobre y punto técnico de entrada se vuelven visibles." },
      { key: "networks", step: "02", label: "Redes", title: "La conectividad se estabiliza", text: "Wi-Fi, puntos de acceso y topología se planifican como una capa mantenible." },
      { key: "electricity", step: "03", label: "Energía", title: "La energía se enruta y controla", text: "Cuadros, circuitos y cableado smart-ready preparan el espacio para ampliaciones." },
      { key: "security", step: "04", label: "Seguridad", title: "El perímetro queda claro", text: "Alarmas, CCTV y zonas se conectan con el plan de infraestructura." },
      { key: "quote", step: "05", label: "Presupuesto", title: "La solicitud se vuelve accionable", text: "La ruta técnica se convierte en un brief claro para la instalación." },
    ]
  : [
      { key: "telecom", step: "01", label: "Telecom", title: "Signal enters the space", text: "Provider handoff, fiber/copper lines and the technical entry point become visible." },
      { key: "networks", step: "02", label: "Networks", title: "Connectivity becomes stable", text: "Wi-Fi, access points and topology are planned as a supportable layer." },
      { key: "electricity", step: "03", label: "Power", title: "Energy gets routed and controlled", text: "Panels, circuits and smart-ready wiring prepare the space for upgrades." },
      { key: "security", step: "04", label: "Security", title: "The perimeter becomes clear", text: "Alarms, CCTV and zones connect to the wider infrastructure plan." },
      { key: "quote", step: "05", label: "Quote", title: "The request becomes actionable", text: "The technical path turns into a clear quote brief for the installation." },
    ];

const quoteSpaceTypes = isEs
  ? ["Piso", "Casa / villa", "Oficina", "Retail / hospitality", "Sala técnica"]
  : ["Apartment", "House / villa", "Office", "Retail / hospitality", "Technical room"];
const quoteTimelines = isEs
  ? ["Planificación", "Este mes", "1-3 meses", "Incidencia urgente"]
  : ["Planning", "This month", "1-3 months", "Urgent site issue"];
const quoteConstraints = isEs
  ? ["Cableado existente", "Nueva reforma", "Entrada de operador", "Acceso a cuadro / rack", "Ruta exterior", "Barcelona"]
  : ["Existing wiring", "New renovation", "Provider handoff", "Panel / rack access", "Outdoor routing", "Barcelona area"];

const pageNavItems = copy.pageNavItems;
---

<BaseLayout
  title={layoutTitle}
  description={layoutDescription}
  noindex={layoutNoindex}
>
  <div class={`homeV2 ${isEs ? "isSpanish" : ""}`.trim()}>
  <div class="livingAtmosphere" aria-hidden="true">
    <div class="atmoLayer atmoGrid"></div>
    <div class="atmoLayer atmoField"></div>
    <div class="atmoLayer atmoSignals"></div>
    <div class="atmoLayer atmoNoise"></div>
  </div>

  <nav class="pageNav" data-page-nav aria-label={copy.navAria}>
    <div class="pageNavTrack" aria-hidden="true"><span data-page-progress></span></div>
    {pageNavItems.map((item) => (
      <a href={item.href} data-page-nav-link aria-label={item.label}>
        <span>{item.index}</span>
        <strong>{item.label}</strong>
      </a>
    ))}
  </nav>

  <section id="signal-field" class="v2Hero">
    <div class="heroGrid">
      <div class="heroCopy">
        <div class="conceptLabel">{copy.conceptLabel}</div>

        <h1>{copy.heroTitle}</h1>

        <p class="lead">
          {copy.heroLead}
        </p>

        <div class="actions">
          <a class="primary" href="#technical-request" data-vt="1" data-track="home_hero_quote">{copy.quoteCta}</a>
          <a class="secondary" href={servicesHref} data-vt="1" data-track="home_hero_services">{copy.servicesCta}</a>
        </div>

        <div class="signalFormula" aria-label="Commercial journey">
          {copy.formula.map((item, index) => (
            <>
              <span>{item}</span>
              {index < copy.formula.length - 1 ? <i></i> : null}
            </>
          ))}
        </div>

        <div class="focusRail" aria-label={copy.focusAria}>
          {journeyFocus.map((item) => (
            <button type="button" data-field-focus={item.key}>
              <span>{item.step}</span>
              {item.label}
            </button>
          ))}
        </div>
      </div>

      <div class="signalStage" aria-label={copy.signalStageAria}>
        <SignalInfrastructureField locale={locale} client:visible />
        <div class="stageCaption">
          <span>{copy.stageCaption}</span>
          <small>{copy.stageCaptionSmall}</small>
        </div>
      </div>
    </div>

    <div class="scrollFocusStack" aria-label="Infrastructure journey">
      {journeyFocus.map((item) => (
        <article class="focusStep" data-scroll-focus={item.key}>
          <span>{item.step} / {item.label}</span>
          <strong>{item.title}</strong>
          <p>{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <div class="container"><div class="hr"></div></div>

  <section id="system-map" class="systemSection">
    <div class="container">
      <div class="sectionHead">
        <div class="eyebrow">{copy.systemEyebrow}</div>
        <h2>{copy.systemTitle}</h2>
        <p>{copy.systemText}</p>
      </div>

      <div class="systemMap" data-active-system="telecom">
        <div class="mapHud" aria-hidden="true">
          <span>{copy.mapHud}</span>
          <strong>{copy.conceptLabel}</strong>
        </div>

        <div class="mapRoutes" aria-hidden="true">
          <span class="route routeSignal"></span>
          <span class="route routePower"></span>
          <span class="route routeSecurity"></span>
          <span class="route routeSupport"></span>
        </div>

        <svg class="mapFlow" viewBox="0 0 1000 520" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="flowBlue" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="rgba(10,132,255,0)" />
              <stop offset="48%" stop-color="rgba(10,132,255,.72)" />
              <stop offset="100%" stop-color="rgba(10,132,255,0)" />
            </linearGradient>
            <linearGradient id="flowAmber" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="rgba(255,186,94,0)" />
              <stop offset="50%" stop-color="rgba(205,158,60,.72)" />
              <stop offset="100%" stop-color="rgba(255,186,94,0)" />
            </linearGradient>
            <linearGradient id="flowCyan" x1="0%" y1="0%" x2="100%" y2="0%">
              <stop offset="0%" stop-color="rgba(35,198,190,0)" />
              <stop offset="52%" stop-color="rgba(35,198,190,.62)" />
              <stop offset="100%" stop-color="rgba(35,198,190,0)" />
            </linearGradient>
          </defs>

          <ellipse class="flowOrbit" cx="500" cy="260" rx="430" ry="205" />
          <path class="flowLine flowTelecom" d="M500 260 C410 218 285 146 132 132" />
          <path class="flowLine flowNetworks" d="M500 260 C630 205 750 142 868 132" />
          <path class="flowLine flowElectricity" d="M500 260 C410 305 285 382 168 392" />
          <path class="flowLine flowEv" d="M500 260 C626 314 742 388 866 390" />
          <path class="flowLine flowAlarms" d="M500 260 C502 206 502 126 500 82" />
          <path class="flowLine flowAudio" d="M500 260 C502 322 502 398 500 442" />
        </svg>

        <div class="mapBeacons" aria-hidden="true">
          <span class="b1"></span>
          <span class="b2"></span>
          <span class="b3"></span>
          <span class="b4"></span>
        </div>

        {systemNodes.map((node, index) => (
          <a
            class={`systemNode n${index + 1}`}
            href={`${basePath}/services/${node.key}`}
            data-vt="1"
            data-system-node={node.key}
            aria-label={`Open ${node.label}`}
          >
            <span class="nodeIndex">{String(index + 1).padStart(2, "0")}</span>
            <strong>{node.label}</strong>
            <em>{node.signal}</em>
            <p>{node.note}</p>
          </a>
        ))}

        <div class="mapCore" data-system-node="system">
          <span>{copy.mapCoreTop}</span>
          <strong>{copy.mapCoreMain}</strong>
        </div>
      </div>

      <section id="infrastructure-logic" class="impactStrip" data-impact-strip aria-label={copy.impactAria}>
        <div class="impactStripHead">
          <span>{copy.impactLabel}</span>
          <p>{copy.impactText}</p>
        </div>

        <div class="impactLine" aria-hidden="true">
          <span></span>
        </div>

        <div class="impactStats">
          {impactStats.map((item) => (
            <article class="impactStat" data-impact-stat>
              <strong>
                <span data-impact-value data-target={item.value} data-suffix={item.suffix}>0</span>
              </strong>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </section>

  <section id="service-journey" class="pathSection">
    <div class="container">
      <div class="sectionHead compact">
        <div class="eyebrow">{copy.journeyEyebrow}</div>
        <h2>{copy.journeyTitle}</h2>
        <p>{copy.journeyText}</p>
      </div>

      <div class="pathStage">
        <div class="pathRoute" aria-hidden="true"></div>
        <div
          class="pathGrid"
          data-mobile-carousel="home-paths"
          data-mobile-carousel-tablet="true"
          data-mobile-carousel-label={copy.journeyTitle}
          data-mobile-carousel-mobile-limit="3"
        >
          {process.map((item, index) => (
            <article class="pathItem">
              <span>{item.step}</span>
              <dl>
                <div>
                  <dt>{copy.inputLabel}</dt>
                  <dd>{item.input}</dd>
                </div>
                <div>
                  <dt>{copy.outputLabel}</dt>
                  <dd>{item.output}</dd>
                </div>
              </dl>
              <ul>
                {item.details.map((detail) => <li>{detail}</li>)}
              </ul>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

