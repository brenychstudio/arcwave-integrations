---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteEs } from "../../content/site.es";
import "../../styles/interface.css";

const process = [
  {
    index: "01",
    title: "Senal",
    text: "La solicitud empieza como una necesidad: cobertura, energia, carga, seguridad, control o audio.",
    details: ["Categoria", "Tipo de espacio", "Problema principal"],
  },
  {
    index: "02",
    title: "Sistema",
    text: "ARCWAVE mapea el servicio como parte de una capa tecnica conectada.",
    details: ["Dependencias", "Rutas", "Limitaciones"],
  },
  {
    index: "03",
    title: "Ruta",
    text: "Alcance, materiales, acceso y recorrido quedan claros antes de presupuestar.",
    details: ["Ruta de instalacion", "Equipos", "Plazo"],
  },
  {
    index: "04",
    title: "Prueba",
    text: "La claridad tecnica sustituye las promesas genericas: etiquetas, notas y contexto.",
    details: ["Pruebas", "Etiquetas", "Entrega"],
  },
  {
    index: "05",
    title: "Presupuesto",
    text: "La respuesta se basa en el espacio, las limitaciones y el resultado esperado.",
    details: ["Alcance", "Siguientes pasos", "Respuesta"],
  },
];
---

<BaseLayout
  title={`Proceso - ${siteEs.name}`}
  description="Senal, sistema, ruta de servicio, prueba y presupuesto para instalaciones tecnicas mantenibles."
>
  <div class="interfacePage">
    <section class="interfaceHero">
      <div class="interfaceHeroCopy motionIn">
        <div class="interfaceEyebrow">Ruta de instalacion</div>
        <h1 class="interfaceTitle">De necesidad suelta a sistema instalado.</h1>
        <p class="interfaceLead">
          El proceso ARCWAVE convierte una solicitud tecnica poco definida en una
          ruta clara: dependencias, limitaciones, instalacion limpia y entrega mantenible.
        </p>
        <div class="interfaceActions">
          <a class="primary" href="/es/contact#quote" data-vt="1">Solicitar presupuesto</a>
          <a class="secondary" href="/es/services" data-vt="1">Explorar servicios</a>
        </div>
        <div class="interfaceFormula" aria-label="Formula de proceso">
          <span>senal</span><i></i><span>sistema</span><i></i><span>ruta</span><i></i><span>prueba</span><i></i><span>presupuesto</span>
        </div>
      </div>

      <div class="interfacePanel processHeroPanel motionIn" aria-label="Sistema de proceso">
        {process.map((item) => (
          <div class="processNode">
            <span>{item.index}</span>
            <strong>{item.title}</strong>
          </div>
        ))}
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Journey de servicio</div>
          <p>
            La ruta ayuda a comprar trabajo tecnico invisible con menos dudas:
            mejores decisiones, menos supuestos y entrega mas clara.
          </p>
        </div>
        <h2>Una ruta tecnica comprensible.</h2>
      </div>

      <div class="interfaceTopology">
        <div class="processGrid">
          {process.map((item) => (
            <article class="interfaceCard pathStep">
              <span class="interfaceIndex">{item.index}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <ul>
                  {item.details.map((detail) => <li>{detail}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Claridad de entrega</div>
          <p>
            La confianza viene de lo que se comprueba, se instala y se entrega de
            forma legible para soporte futuro.
          </p>
        </div>
        <h2>Lo que ARCWAVE hace explicito.</h2>
      </div>

      <div class="interfaceMetrics">
        <article class="interfaceMetric">
          <span class="interfaceIndex">01 / Alcance</span>
          <strong>Limitaciones antes de comprometerse.</strong>
          <p>Acceso, distancias, cableado existente, cuadro y entrada de operador se aclaran pronto.</p>
        </article>
        <article class="interfaceMetric">
          <span class="interfaceIndex">02 / Instalacion</span>
          <strong>Trabajo limpio que se entiende despues.</strong>
          <p>Rutas, etiquetas, terminaciones y decisiones practicas forman parte del servicio.</p>
        </article>
        <article class="interfaceMetric">
          <span class="interfaceIndex">03 / Entrega</span>
          <strong>Un sistema, no una caja negra.</strong>
          <p>Notas y contexto de soporte facilitan mantenimiento y futuras mejoras.</p>
        </article>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfacePanel interfaceCta">
        <div>
          <div class="interfaceEyebrow">Siguiente paso</div>
          <h2>Convierte tu espacio en un brief tecnico.</h2>
          <p>
            Selecciona la ruta de servicio, describe el espacio y las limitaciones,
            y ARCWAVE podra responder con mejores preguntas y un presupuesto mas claro.
          </p>
        </div>
        <a class="primary" href="/es/contact#quote" data-vt="1">Solicitar presupuesto</a>
      </div>
    </section>
  </div>

  <style>
    .processHeroPanel{
      min-height: 680px;
      display:grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px;
      align-items:end;
      padding: clamp(18px, 2.4vw, 34px);
    }
    .processNode{
      position:relative;
      z-index:2;
      min-height: 190px;
      display:flex;
      flex-direction:column;
      justify-content:space-between;
      padding: 18px;
      border-radius: 22px;
      border: 1px solid rgba(15,15,20,.075);
      background: rgba(255,255,255,.70);
      box-shadow: 0 18px 60px rgba(10,10,20,.08);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .processNode:nth-child(2),
    .processNode:nth-child(4){ min-height: 280px; }
    .processNode:nth-child(3){ min-height: 390px; }
    .processNode span{
      color: rgba(10,132,255,.78);
      font-size: 12px;
      letter-spacing:.16em;
      font-weight:760;
    }
    .processNode strong{
      font-size: clamp(24px, 2.2vw, 38px);
      line-height:.96;
      letter-spacing:-.04em;
    }
    @media (max-width: 1180px){
      .processHeroPanel{ min-height:auto; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .processNode,
      .processNode:nth-child(2),
      .processNode:nth-child(3),
      .processNode:nth-child(4){ min-height: 220px; }
    }
    @media (max-width: 760px){ .processHeroPanel{ grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
