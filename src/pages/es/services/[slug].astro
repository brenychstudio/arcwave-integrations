---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { siteEs } from "../../../content/site.es";
import { servicesEs } from "../../../content/services.es";
import type { Service } from "../../../content/services";
import "../../../styles/interface.css";

export async function getStaticPaths() {
  return servicesEs.map((s) => ({
    params: { slug: s.key },
    props: { service: s },
  }));
}

const service = (Astro.props as { service?: Service }).service;
if (!service) return Astro.redirect("/es/services");

const serviceIndex = servicesEs.findIndex((item) => item.key === service.key);
const serviceNumber = String(serviceIndex + 1).padStart(2, "0");
const relatedServices = servicesEs.filter((item) => item.key !== service.key).slice(0, 3);
const quoteHref = `/es/contact?service=${service.key}#quote`;
const desc = service.description || service.short;

const servicePath = [
  { index: "01 / Senal", title: "La necesidad se vuelve visible.", text: service.short },
  {
    index: "02 / Sistema",
    title: "Las dependencias se mapean.",
    text: "Rutas, acceso, energia, red y limitaciones de soporte se aclaran antes de instalar.",
  },
  {
    index: "03 / Entrega",
    title: "El resultado queda mantenible.",
    text: "Etiquetas, notas practicas y recomendaciones dejan el sistema legible despues del trabajo.",
  },
];
---

<BaseLayout title={`${service.title} - ${siteEs.name}`} description={desc}>
  <div class="interfacePage">
    <section class="interfaceHero">
      <div class="interfaceHeroCopy motionIn">
        <div class="interfaceEyebrow">{serviceNumber} / Ruta de servicio</div>
        <h1 class="interfaceTitle">{service.title}</h1>
        <p class="interfaceLead">{desc}</p>
        <div class="interfaceActions">
          <a class="primary" href={quoteHref} data-vt="1">Solicitar presupuesto</a>
          <a class="secondary" href="/es/services" data-vt="1">Todos los servicios</a>
        </div>
        <div class="interfaceFormula" aria-label="Ruta de servicio">
          <span>senal</span><i></i><span>sistema</span><i></i><span>entrega</span><i></i><span>presupuesto</span>
        </div>
      </div>

      <div class="interfacePanel detailHeroPanel motionIn">
        <img src={service.heroImage} alt="" loading="eager" decoding="async" />
        <div class="interfacePanelContent">
          <div>
            <span class="interfaceIndex">Capa activa</span>
            <h2>{service.title}</h2>
            <p>{service.short}</p>
          </div>
          <div class="detailChip">Barcelona</div>
        </div>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Ruta tecnica</div>
          <p>
            Esta pagina presenta {service.title} como una ruta instalable: necesidad,
            sistema, limitaciones y entrega clara.
          </p>
        </div>
        <h2>De solicitud a sistema mantenible.</h2>
      </div>

      <div class="detailPathGrid">
        {servicePath.map((item) => (
          <article class="interfaceCard detailTile">
            <span class="interfaceIndex">{item.index}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Alcance claro</div>
          <p>
            Los entregables se confirman con el sitio real: acceso, rutas,
            materiales, limitaciones y nivel de soporte esperado.
          </p>
        </div>
        <h2>Que puede incluir este servicio.</h2>
      </div>

      <div class="deliverableGrid">
        <ul class="deliverableList">
          {service.bullets.map((item) => <li>{item}</li>)}
        </ul>

        <aside class="interfaceCard factsPanel">
          <span class="interfaceIndex">Contexto de presupuesto</span>
          <dl>
            <div><dt>Respuesta</dt><dd>1-2 dias laborables</dd></div>
            <div><dt>Area</dt><dd>{siteEs.contact.serviceArea}</dd></div>
            <div><dt>Siguiente</dt><dd><a href={quoteHref}>Solicitar presupuesto</a></dd></div>
            <div><dt>Preseleccion</dt><dd>{service.title}</dd></div>
          </dl>
        </aside>
      </div>
    </section>

    {service.faqs?.length ? (
      <section class="interfaceSection">
        <div class="interfaceSectionHead">
          <div>
            <div class="interfaceEyebrow">Soporte de decision</div>
            <p>Respuestas breves para reducir friccion antes de solicitar presupuesto.</p>
          </div>
          <h2>Preguntas frecuentes.</h2>
        </div>

        <div class="faqGrid">
          {service.faqs.map((item) => (
            <details class="interfaceCard interfaceFaq">
              <summary>{item.q}</summary>
              <div>{item.a}</div>
            </details>
          ))}
        </div>
      </section>
    ) : null}

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Rutas relacionadas</div>
          <p>Muchas instalaciones conectan mas de una capa tecnica.</p>
        </div>
        <h2>Capas de infraestructura cercanas.</h2>
      </div>

      <div class="servicePathGrid interfaceTopology">
        {relatedServices.map((item, index) => (
          <a class="interfaceCard servicePathCard" href={`/es/services/${item.key}`} data-vt="1">
            <div>
              <span class="interfaceIndex">{String(index + 1).padStart(2, "0")} / Relacionada</span>
              <h3>{item.title}</h3>
              <p>{item.short}</p>
            </div>
            <div class="servicePathMeta">
              <span>Capa tecnica</span>
              <span>Ruta de presupuesto</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfacePanel interfaceCta">
        <div>
          <div class="interfaceEyebrow">Solicitud tecnica</div>
          <h2>Solicita presupuesto para {service.title}.</h2>
          <p>
            Abre el formulario con este servicio seleccionado y anade las limitaciones
            importantes del sitio: acceso, rutas, cableado existente, plazo y resultado esperado.
          </p>
        </div>
        <a class="primary" href={quoteHref} data-vt="1">Solicitar presupuesto</a>
      </div>
    </section>
  </div>
</BaseLayout>
