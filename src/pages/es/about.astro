---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { siteEs } from "../../content/site.es";
import "../../styles/interface.css";

const principles = [
  {
    index: "01 / Claridad",
    title: "Hacer legible lo invisible.",
    text: "Topología, rutas, etiquetas y restricciones forman parte del servicio, no son detalles secundarios.",
  },
  {
    index: "02 / Disciplina",
    title: "Lo premium es ejecución.",
    text: "Rutas limpias, ubicación sensata, pruebas y documentación crean calidad que se nota meses después.",
  },
  {
    index: "03 / Confianza",
    title: "Sin promesas infladas.",
    text: "Las referencias a normativa y cumplimiento se usan solo cuando aplican al alcance y pueden documentarse.",
  },
];

const operatingSignals = [
  "Las rutas de servicio se mapean como sistemas conectados.",
  "El alcance y las restricciones se aclaran antes del compromiso.",
  "La entrega se diseña para soporte, ampliaciones y trabajo futuro.",
  "El flujo de presupuesto convierte necesidades abiertas en un brief práctico.",
];
---

<BaseLayout
  title={`Sobre - ${siteEs.name}`}
  description="ARCWAVE es una integración técnica premium para infraestructura invisible: telecomunicaciones, redes, electricidad, carga VE, seguridad y audio como un sistema mantenible."
>
  <div class="interfacePage aboutPage">
    <section class="interfaceHero">
      <div class="interfaceHeroCopy motionIn">
        <div class="interfaceEyebrow">Sobre ARCWAVE</div>
        <h1 class="interfaceTitle">Sistemas invisibles, diseñados para generar confianza.</h1>
        <p class="interfaceLead">
          ARCWAVE parte de una idea simple: los sistemas que hacen funcionar los
          espacios modernos deben planificarse, instalarse y explicarse como una
          capa técnica conectada.
        </p>
        <div class="interfaceActions">
          <a class="primary" href="/es/services" data-vt="1">Explorar servicios</a>
          <a class="secondary" href="/es/contact#quote" data-vt="1">Solicitar presupuesto</a>
        </div>
        <div class="interfaceFormula" aria-label="Fórmula de compañía">
          <span>señal</span><i></i><span>sistema</span><i></i><span>claridad</span><i></i><span>confianza</span>
        </div>
      </div>

      <div class="interfacePanel aboutHeroPanel motionIn" aria-label="Posicionamiento ARCWAVE">
        <img src="/macro/macro-pcb-01.png" alt="" loading="eager" decoding="async" />
        <div class="aboutSignalCard">
          <span class="interfaceIndex">Posicionamiento</span>
          <strong>Connected Infrastructure OS</strong>
          <p>
            Telecomunicaciones, redes, energía, carga, seguridad y audio como una
            interfaz premium de servicio técnico.
          </p>
        </div>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Principio operativo</div>
          <p>
            ARCWAVE no se presenta como un instalador genérico. La marca se plantea
            como partner técnico que convierte infraestructura oculta en un sistema claro.
          </p>
        </div>
        <h2>Claridad técnica antes que ruido visual.</h2>
      </div>

      <div class="detailPathGrid">
        {principles.map((item) => (
          <article class="interfaceCard detailTile">
            <span class="interfaceIndex">{item.index}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Prueba por claridad</div>
          <p>
            La confianza aparece cuando el trabajo técnico se entiende antes de
            instalarse, entregarse y recibir soporte.
          </p>
        </div>
        <h2>La confianza nace de un sistema legible.</h2>
      </div>

      <div class="deliverableGrid">
        <ul class="deliverableList">
          {operatingSignals.map((item) => <li>{item}</li>)}
        </ul>

        <aside class="interfaceCard factsPanel">
          <span class="interfaceIndex">Contexto de servicio</span>
          <dl>
            <div>
              <dt>Área</dt>
              <dd>{siteEs.contact.serviceArea}</dd>
            </div>
            <div>
              <dt>Núcleo</dt>
              <dd>Telecom, redes, energía, seguridad, audio</dd>
            </div>
            <div>
              <dt>Método</dt>
              <dd>Señal -> sistema -> ruta de servicio -> presupuesto</dd>
            </div>
            <div>
              <dt>Salida</dt>
              <dd>Solicitud técnica clara y entrega mantenible</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceMetrics">
        <article class="interfaceMetric">
          <span class="interfaceIndex">01 / Alcance</span>
          <strong>Definir lo que puede saberse.</strong>
          <p>Acceso, rutas, materiales, cuadros, racks y restricciones entran pronto en la conversación.</p>
        </article>
        <article class="interfaceMetric">
          <span class="interfaceIndex">02 / Instalación</span>
          <strong>Construir para quien dará soporte después.</strong>
          <p>Topología legible, etiquetas y notas convierten el trabajo en un sistema mantenible.</p>
        </article>
        <article class="interfaceMetric">
          <span class="interfaceIndex">03 / Evolución</span>
          <strong>Dejar espacio para la siguiente capa.</strong>
          <p>Las decisiones de energía, datos, seguridad y control deben facilitar futuras mejoras.</p>
        </article>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfacePanel interfaceCta">
        <div>
          <div class="interfaceEyebrow">Solicitud técnica</div>
          <h2>Empieza por el sistema que necesita tu espacio.</h2>
          <p>
            Selecciona una ruta de servicio, describe las restricciones y convierte
            la necesidad en un brief técnico listo para presupuesto.
          </p>
        </div>
        <a class="primary" href="/es/contact#quote" data-vt="1">Solicitar presupuesto</a>
      </div>
    </section>
  </div>

  <style>
    .aboutPage .interfaceHero{
      min-height:auto;
      padding: clamp(39px, 5.6vw, 78px) 0 clamp(35px, 4.7vw, 67px);
    }

    .aboutPage .interfaceSection{
      padding: clamp(52px, 6vw, 96px) 0;
    }

    .aboutPage .interfaceHero + .interfaceSection{
      padding-top: clamp(34px, 4.2vw, 68px);
    }

    .aboutHeroPanel{
      min-height: clamp(500px, 38vw, 620px);
      display:flex;
      align-items:flex-end;
      padding: clamp(22px, 2.8vw, 44px);
    }

    .aboutHeroPanel img{
      position:absolute;
      inset:0;
      width:100%;
      height:100%;
      object-fit:cover;
      opacity:.42;
      filter: grayscale(.08) contrast(1.03);
    }

    .aboutSignalCard{
      position:relative;
      z-index:2;
      max-width: 520px;
      padding: clamp(22px, 2.6vw, 40px);
      border-radius: 28px;
      border: 1px solid rgba(10,132,255,.12);
      background: rgba(255,255,255,.68);
      box-shadow: 0 24px 74px rgba(10,10,20,.08);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .aboutSignalCard strong{
      display:block;
      margin-top: 12px;
      max-width: 9em;
      font-size: clamp(38px, 4vw, 68px);
      line-height:.92;
      letter-spacing:-.06em;
    }

    .aboutSignalCard p{
      margin-top: 18px;
      color: rgba(15,15,20,.62);
      line-height:1.62;
    }

    @media (max-width: 1180px){
      .aboutHeroPanel{ min-height: 500px; }
    }

    @media (max-width: 760px){
      .aboutPage .interfaceHero{
        padding-top: 26px;
        padding-bottom: 26px;
      }

      .aboutPage .interfaceTitle{
        max-width: 100%;
        font-size: clamp(36px, 10.4vw, 46px);
        line-height:.98;
        letter-spacing:-.035em;
        overflow-wrap: break-word;
        text-wrap: balance;
      }

      .aboutPage .interfaceLead{
        max-width: 36ch;
      }

      .aboutPage .interfaceActions{
        display:grid;
        grid-template-columns: 1fr;
        width:100%;
      }

      .aboutPage .interfaceActions .primary,
      .aboutPage .interfaceActions .secondary{
        width:100%;
      }

      .aboutPage .interfaceFormula{
        gap: 8px;
        font-size: 10px;
      }

      .aboutPage .interfaceFormula i{
        width: 18px;
      }

      .aboutPage .interfaceSection{
        padding: 32px 0;
      }

      .aboutHeroPanel{
        min-height: 250px;
        padding: 16px;
        border-radius: 22px;
      }

      .aboutSignalCard{
        padding: 16px;
        border-radius: 18px;
      }

      .aboutSignalCard strong{
        font-size: clamp(29px, 8.6vw, 40px);
        line-height:1;
      }

      .aboutSignalCard p{
        margin-top: 10px;
        font-size: 13px;
        line-height:1.45;
      }
    }
  </style>
</BaseLayout>
