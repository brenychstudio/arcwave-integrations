---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
---

<BaseLayout title="Cookies" description="Cookie information.">
  <Section eyebrow="Legal" title="Cookies">
    <div class="card box">
      <p class="p">
        This site may use essential cookies required for basic navigation, security and form-related functionality.
      </p>

      <div class="hr" style="margin:16px 0;"></div>

      <p class="p small">
        If analytics tools are enabled for launch, they are used only to understand visits, CTA clicks and request flow performance,
        not for advertising profiles. This page should be updated to reflect the final provider configuration before go-live.
      </p>
    </div>
  </Section>

  <style>
    .box{ padding: 18px; border-radius: var(--radius); }
    .p{ margin:0; color: var(--muted); line-height: 1.65; }
    .small{ font-size: 13px; }
  </style>
</BaseLayout>
