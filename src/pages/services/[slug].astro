---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site } from "../../content/site";
import { COMPANY, hasRealEmail } from "../../content/company";
import { services } from "../../content/services";
import type { Service } from "../../content/services";
import { serviceDetails } from "../../content/serviceDetails";
import "../../styles/interface.css";

export async function getStaticPaths() {
  return services
    .filter((s) => typeof s?.key === "string" && s.key.trim().length > 0)
    .map((s) => ({
      params: { slug: s.key },
      props: { service: s },
    }));
}

const service = (Astro.props as { service?: Service }).service;
if (!service) {
  return Astro.redirect("/services");
}

const serviceIndex = services.findIndex((item) => item.key === service.key);
const serviceNumber = String(serviceIndex + 1).padStart(2, "0");
const quoteHref = `/contact?service=${service.key}#quote`;
const desc = service.description || service.short;
const fallbackPath = [
  {
    index: "01 / Signal",
    title: "Need becomes visible.",
    text: service.short,
  },
  {
    index: "02 / System",
    title: "Dependencies are mapped.",
    text: "Routes, access, power, network and support constraints are clarified before installation starts.",
  },
  {
    index: "03 / Handover",
    title: "The result stays supportable.",
    text: "Labels, practical notes and next-step recommendations keep the system readable after the work is complete.",
  },
];
const detail = {
  outcome: service.short,
  activeLayer: service.title,
  activeLayerText: service.short,
  heroTags: [service.title, "Support-ready"],
  pathCards: fallbackPath,
  quoteHints: ["access", "routes", "existing wiring", "timing"],
  relatedServiceKeys: services.filter((item) => item.key !== service.key).map((item) => item.key),
  scopeIntro:
    "Typical deliverables are confirmed against the actual site: access, routing, materials, constraints and the desired level of support.",
  faqIntro: "Short answers to reduce friction before the technical request.",
  ...serviceDetails[service.key],
};
const relatedByKey = detail.relatedServiceKeys
  .map((key) => services.find((item) => item.key === key))
  .filter((item): item is Service => Boolean(item));
const relatedServices =
  relatedByKey.length > 0
    ? relatedByKey.slice(0, 3)
    : services.filter((item) => item.key !== service.key).slice(0, 3);
const servicePath = detail.pathCards;
const heroTags = detail.heroTags.length > 0 ? detail.heroTags : [service.title, "Support-ready"];
const quoteHints = detail.quoteHints.length > 0 ? detail.quoteHints : ["access", "routes", "existing wiring", "timing"];
const finalCtaCopy = `Open the request form with ${service.title} preselected and add the site constraints that matter: ${quoteHints.join(", ")} and desired outcome.`;
const mailHref = hasRealEmail(COMPANY.email) ? `mailto:${COMPANY.email}` : null;
---

<BaseLayout title={`${service.title} - ${site.name}`} description={desc}>
  <div class="interfacePage serviceDetailPage">
    <section class="interfaceHero">
      <div class="interfaceHeroCopy motionIn">
        <div class="interfaceEyebrow">{serviceNumber} / Service path</div>
        <h1 class="interfaceTitle">{service.title}</h1>
        <p class="interfaceLead">{detail.outcome}</p>
        <div class="serviceHeroTags" aria-label="Service signals">
          {heroTags.map((tag) => <span>{tag}</span>)}
        </div>
        <div class="interfaceActions">
          <a class="primary" href={quoteHref} data-vt="1">Request a quote</a>
          <a class="secondary" href="/services" data-vt="1">All services</a>
        </div>
        <div class="interfaceFormula" aria-label="Service path">
          <span>signal</span><i></i><span>system</span><i></i><span>handover</span><i></i><span>quote</span>
        </div>
      </div>

      <div class="interfacePanel detailHeroPanel motionIn">
        <img src={service.heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
        <div class="interfacePanelContent">
          <div>
            <span class="interfaceIndex">Active layer</span>
            <h2>{detail.activeLayer}</h2>
            <p>{detail.activeLayerText}</p>
          </div>
          <div class="detailChip">Barcelona area</div>
        </div>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Technical path</div>
          <p>
            This page frames {service.title} as an installable path: what the customer
            needs, what ARCWAVE maps, and what must be handed over clearly.
          </p>
        </div>
        <h2>From request to supportable system.</h2>
      </div>

      <div class="detailPathGrid">
        {servicePath.map((item) => (
          <article class="interfaceCard detailTile">
            <span class="interfaceIndex">{item.index}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Scope clarity</div>
          <p>{detail.scopeIntro}</p>
        </div>
        <h2>What this service can include.</h2>
      </div>

      <div class="deliverableGrid">
        <ul class="deliverableList">
          {service.bullets.map((item) => <li>{item}</li>)}
        </ul>

        <aside class="interfaceCard factsPanel">
          <span class="interfaceIndex">Quote context</span>
          <dl>
            <div>
              <dt>Response</dt>
              <dd>1-2 business days</dd>
            </div>
            <div>
              <dt>Area</dt>
              <dd>{site.contact.serviceArea}</dd>
            </div>
            <div>
              <dt>Contact</dt>
              <dd>{mailHref ? <a href={mailHref} data-track="service_detail_email">{COMPANY.email}</a> : "Use the request form"}</dd>
            </div>
            <div>
              <dt>Preselect</dt>
              <dd>{service.title}</dd>
            </div>
          </dl>
          <div class="quoteHints" aria-label="Quote hints">
            {quoteHints.map((hint) => <span>{hint}</span>)}
          </div>
        </aside>
      </div>
    </section>

    <section class="interfaceSection serviceSupportSection">
      <div class="interfaceSectionHead">
        <div>
          <div class="interfaceEyebrow">Decision support</div>
          <p>{detail.faqIntro}</p>
        </div>
        <h2>Questions and connected layers.</h2>
      </div>

      <div class="serviceSupportGrid">
        {service.faqs?.length ? (
          <div class="supportFaqList">
            {service.faqs.map((item) => (
              <details class="interfaceCard interfaceFaq compactFaq">
                <summary>{item.q}</summary>
                <div>{item.a}</div>
              </details>
            ))}
          </div>
        ) : null}

        <aside class="interfaceTopology relatedCompactPanel">
          <div class="relatedCompactHead">
            <span class="interfaceIndex">Related paths</span>
            <p>Most installations touch more than one layer. These paths often connect.</p>
          </div>

          <div class="relatedCompactList">
            {relatedServices.map((item, index) => (
              <a class="interfaceCard relatedCompactCard" href={`/services/${item.key}`} data-vt="1">
                <div>
                  <span class="interfaceIndex">{String(index + 1).padStart(2, "0")} / Related</span>
                  <h3>{item.title}</h3>
                  <p>{item.short}</p>
                </div>
                <div class="relatedCompactFooter">
                  <div class="servicePathMeta">
                    <span>System layer</span>
                    <span>Quote-ready path</span>
                  </div>
                  <span class="relatedCompactCta">View path</span>
                </div>
              </a>
            ))}
          </div>
        </aside>
      </div>
    </section>

    <section class="interfaceSection">
      <div class="interfacePanel interfaceCta">
        <div>
          <div class="interfaceEyebrow">Technical request</div>
          <h2>Get a clear quote for {service.title}.</h2>
          <p>{finalCtaCopy}</p>
        </div>
        <a class="primary" href={quoteHref} data-vt="1">Request a quote</a>
      </div>
    </section>
  </div>
</BaseLayout>
