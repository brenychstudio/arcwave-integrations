---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuoteForm from "../components/forms/QuoteForm.tsx";
import { site } from "../content/site";
import { COMPANY, hasRealEmail } from "../content/company";
import { services, commonQuoteFields } from "../content/services";
import type { ServiceKey } from "../content/services";
import "../styles/interface.css";

const serviceParamRaw = Astro.url.searchParams.get("service");
const serviceParam = serviceParamRaw === "cctv" ? "alarms" : serviceParamRaw;

const defaultServiceKey: ServiceKey | undefined =
  services.some((s) => s.key === serviceParam) ? (serviceParam as ServiceKey) : undefined;

const telHref = `tel:${COMPANY.phoneTel}`;
const mailHref = hasRealEmail(COMPANY.email) ? `mailto:${COMPANY.email}` : null;
const requestSteps = ["Service", "Space", "Constraints", "Brief"];
---

<BaseLayout
  title={`Contact - ${site.name}`}
  description="Turn a technical need into a clear ARCWAVE quote brief for telecom, networks, electricity, EV charging, security or audio."
>
  <div class="interfacePage contactPage">
    <section class="interfaceHero">
      <div class="interfaceHeroCopy motionIn">
        <div class="interfaceEyebrow">Technical request hub</div>
        <h1 class="interfaceTitle">Turn a need into a clear install brief.</h1>
        <p class="interfaceLead">
          Select the service path, describe the space and constraints, and give
          ARCWAVE enough signal to respond with a practical technical path.
        </p>
        <div class="interfaceActions">
          <a class="primary" href="#quote" data-track="contact_hero_start_request">Start request</a>
          <a class="secondary" href="/services" data-vt="1">Explore services</a>
        </div>
        <div class="interfaceFormula" aria-label="Request flow">
          <span>service</span><i></i><span>space</span><i></i><span>constraints</span><i></i><span>brief</span>
        </div>
      </div>

      <div class="interfacePanel contactHeroPanel motionIn" aria-label="Contact interface">
        <div class="briefPreview">
          <span class="interfaceIndex">Live brief</span>
          <strong>Ready for technical review</strong>
          <p>Service, space type, timing and constraints become a supportable request.</p>
        </div>
        <div class="briefRows">
          <div><span>Service</span><strong>{defaultServiceKey ? services.find((s) => s.key === defaultServiceKey)?.title : "Networks"}</strong></div>
          <div><span>Area</span><strong>{site.contact.serviceArea}</strong></div>
          <div><span>Response</span><strong>1-2 business days</strong></div>
        </div>
      </div>
    </section>

    <section class="interfaceSection" id="quote">
      <div class="contactGrid">
        <aside class="contactAside">
          <div class="interfaceEyebrow">Direct contact</div>
          <h2 class="contactTitle">A short brief is enough to start.</h2>
          <p>
            For faster review, include site access, rack or panel location, existing
            wiring, approximate distances and any building constraints.
          </p>

          <div class="contactChannels">
            {mailHref ? (
              <a class="interfaceCard contactChannel" href={mailHref} data-track="contact_page_email">
                <span>Email</span>
                <strong>{COMPANY.email}</strong>
              </a>
            ) : null}
            <a class="interfaceCard contactChannel" href={telHref}>
              <span>Phone</span>
              <strong>{COMPANY.phoneDisplay}</strong>
            </a>
            <div class="interfaceCard contactChannel">
              <span>Service area</span>
              <strong>{site.contact.serviceArea}</strong>
            </div>
            <div class="interfaceCard contactChannel">
              <span>Hours</span>
              <strong>{COMPANY.hours}</strong>
            </div>
          </div>
        </aside>

        <div class="interfacePanel requestPanel">
          <div class="requestHead">
            <span class="interfaceIndex">Signal intake</span>
            <h2>Technical request interface</h2>
            <p>
              Select the service path, describe the space and constraints, and
              prepare a brief ARCWAVE can review.
            </p>
          </div>

          <div class="requestRail" aria-label="Request stages">
            {requestSteps.map((step, index) => (
              <>
                <span><b>{String(index + 1).padStart(2, "0")}</b>{step}</span>
                {index < requestSteps.length - 1 ? <i></i> : null}
              </>
            ))}
          </div>

          <QuoteForm
            client:idle
            services={services}
            endpoint={site.form.endpoint}
            commonFields={commonQuoteFields}
            defaultServiceKey={defaultServiceKey}
            fallbackEmail={mailHref ? COMPANY.email : undefined}
            fallbackSubject={`${site.name} - quote request`}
          />
        </div>
      </div>
    </section>

    <section class="interfaceSection contactGuidanceSection">
      <div class="guidanceHead">
        <div class="interfaceEyebrow">What to include</div>
        <h2>A useful request includes.</h2>
      </div>

      <div class="interfaceMetrics">
        <article class="interfaceMetric">
          <span class="interfaceIndex">01 / Useful signal</span>
          <strong>Describe the space.</strong>
          <p>Apartment, house, office, retail, technical room or other context.</p>
        </article>
        <article class="interfaceMetric">
          <span class="interfaceIndex">02 / Constraints</span>
          <strong>Name what may affect routing.</strong>
          <p>Existing wiring, provider handoff, panel access, outdoor runs or timing pressure.</p>
        </article>
        <article class="interfaceMetric">
          <span class="interfaceIndex">03 / Response</span>
          <strong>Get a clearer next step.</strong>
          <p>ARCWAVE can answer with clarifying questions, scope and a practical quote path.</p>
        </article>
      </div>
    </section>
  </div>

  <style>
    #quote{ scroll-margin-top: 120px; }

    .contactPage .interfaceHero{
      min-height:auto;
      padding: clamp(44px, 6vw, 86px) 0 clamp(42px, 5.4vw, 78px);
    }

    .contactPage .interfaceSection{
      padding: clamp(52px, 6vw, 96px) 0;
    }

    .contactPage .interfaceHero + .interfaceSection{
      padding-top: clamp(28px, 3.6vw, 58px);
    }

    .contactHeroPanel{
      min-height: clamp(500px, 39vw, 620px);
      display:flex;
      flex-direction:column;
      justify-content:center;
      gap: clamp(28px, 3vw, 48px);
      padding: clamp(22px, 2.8vw, 44px);
    }

    .briefPreview,
    .briefRows{
      position:relative;
      z-index:2;
    }

    .briefPreview{
      max-width: 560px;
      padding: clamp(22px, 2.6vw, 40px);
      border-radius: 28px;
      border: 1px solid rgba(10,132,255,.12);
      background: rgba(255,255,255,.66);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
    }

    .briefPreview strong{
      display:block;
      margin-top: 12px;
      max-width: 8em;
      font-size: clamp(42px, 5vw, 76px);
      line-height:.9;
      letter-spacing:-.06em;
    }

    .briefPreview p{
      margin-top: 18px;
      max-width: 44ch;
    }

    .briefRows{
      display:grid;
      gap: 1px;
      overflow:hidden;
      border: 1px solid rgba(15,15,20,.075);
      border-radius: 24px;
      background: rgba(15,15,20,.06);
    }

    .briefRows div{
      display:grid;
      grid-template-columns: 130px 1fr;
      gap: 18px;
      padding: 18px;
      background: rgba(255,255,255,.70);
    }

    .briefRows span{
      color: var(--muted2);
      font-size: 11px;
      letter-spacing:.16em;
      text-transform:uppercase;
      font-weight:760;
    }

    .briefRows strong{
      color: rgba(15,15,20,.74);
    }

    .contactTitle{
      margin: 20px 0 0;
      max-width: 7em;
      font-size: clamp(44px, 5.8vw, 96px);
      line-height:.9;
      letter-spacing:-.06em;
    }

    .contactAside > p{
      margin: 18px 0 24px;
      max-width: 44ch;
      color: rgba(15,15,20,.62);
      line-height:1.7;
    }

    .contactPage .contactChannels{
      gap: 1px;
      overflow:hidden;
      border-radius: 24px;
      border: 1px solid rgba(15,15,20,.075);
      background: rgba(15,15,20,.055);
      box-shadow: 0 24px 76px rgba(10,10,20,.07);
    }

    .contactPage .contactChannel{
      grid-template-columns: minmax(96px, .34fr) minmax(0, 1fr);
      align-items:center;
      gap: 16px;
      min-height: 68px;
      padding: 14px 16px;
      border:0;
      border-radius:0;
      background: rgba(255,255,255,.72);
      box-shadow:none;
    }

    .contactPage .contactChannel strong{
      font-size: 17px;
      line-height:1.2;
    }

    .contactPage .requestPanel{
      overflow:hidden;
      background:
        linear-gradient(rgba(10,132,255,.026) 1px, transparent 1px),
        linear-gradient(90deg, rgba(10,132,255,.026) 1px, transparent 1px),
        linear-gradient(135deg, rgba(10,132,255,.07), transparent 45%),
        linear-gradient(180deg, rgba(255,255,255,.94), rgba(255,255,255,.86)),
        rgba(255,255,255,.88);
      background-size: 52px 52px, 52px 52px, auto, auto;
    }

    .contactPage .requestPanel:after{
      opacity:.10;
    }

    .contactPage .requestPanel:before{
      opacity:.42;
      background: rgba(255,255,255,.58);
    }

    .requestHead{
      position:relative;
      z-index:2;
      margin-bottom: 18px;
    }

    .requestHead h2{
      margin-top: 10px;
      font-size: clamp(34px, 3.2vw, 58px);
      line-height:.95;
      letter-spacing:-.05em;
    }

    .requestHead p{
      margin-top: 12px;
      max-width: 58ch;
      color: rgba(15,15,20,.62);
    }

    .requestRail{
      position:relative;
      z-index:2;
      display:grid;
      grid-template-columns: auto minmax(18px, 1fr) auto minmax(18px, 1fr) auto minmax(18px, 1fr) auto;
      align-items:center;
      gap: 10px;
      margin-bottom: 22px;
      padding: 12px 14px;
      border-radius: 18px;
      border: 1px solid rgba(15,15,20,.07);
      background: rgba(255,255,255,.72);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.86);
    }

    .requestRail span{
      display:inline-flex;
      align-items:center;
      gap: 7px;
      color: rgba(15,15,20,.62);
      font-size: 11px;
      font-weight:760;
      letter-spacing:.12em;
      text-transform:uppercase;
      white-space:nowrap;
    }

    .requestRail b{
      color: rgba(10,132,255,.78);
      font: inherit;
    }

    .requestRail i{
      height: 1px;
      background: linear-gradient(90deg, rgba(10,132,255,.36), rgba(35,198,190,.16));
    }

    .contactPage .requestPanel .in{
      border-color: rgba(15,15,20,.095);
      background: rgba(255,255,255,.90);
      box-shadow: inset 0 1px 0 rgba(255,255,255,.94);
    }

    .contactPage .requestPanel .k{
      color: rgba(15,15,20,.55);
      font-weight:760;
    }

    .contactGuidanceSection{
      padding-top: clamp(28px, 3.8vw, 58px);
    }

    .guidanceHead{
      display:flex;
      align-items:flex-end;
      justify-content:space-between;
      gap: 24px;
      margin-bottom: clamp(18px, 2.8vw, 34px);
    }

    .guidanceHead h2{
      margin:0;
      max-width: 8em;
      font-size: clamp(38px, 5vw, 76px);
      line-height:.92;
      letter-spacing:-.06em;
    }

    .contactGuidanceSection .interfaceMetric{
      min-height: clamp(190px, 16vw, 240px);
      padding: clamp(20px, 2.4vw, 34px);
    }

    @media (max-width: 1180px){
      .contactHeroPanel{
        min-height: 500px;
      }
    }

    @media (max-width: 760px){
      .contactPage .interfaceHero{
        padding-top: 26px;
        padding-bottom: 28px;
      }

      .contactPage .interfaceSection{
        padding: 32px 0;
      }

      .contactPage .interfaceHero + .interfaceSection{
        padding-top: 18px;
      }

      .contactHeroPanel{
        min-height: auto;
        gap: 18px;
        padding: 16px;
        border-radius: 22px;
      }

      .briefPreview{
        padding: 16px;
        border-radius: 18px;
      }

      .briefPreview strong{
        max-width: 10em;
        font-size: clamp(28px, 8.8vw, 40px);
        line-height:1;
      }

      .briefPreview p{
        margin-top: 10px;
        font-size: 13px;
        line-height:1.45;
      }

      .briefRows div{
        grid-template-columns: 1fr;
        gap: 5px;
        padding: 12px;
      }

      .contactGrid{
        display:flex;
        flex-direction:column;
        gap: 22px;
      }

      .requestPanel{
        order:1;
      }

      .contactAside{
        order:2;
      }

      .contactTitle{
        max-width: 9em;
        font-size: clamp(32px, 9vw, 44px);
        line-height:.98;
      }

      .contactPage .contactChannel{
        grid-template-columns: 1fr;
        min-height: auto;
        gap: 5px;
        padding: 12px;
      }

      .contactPage .contactChannel strong{
        overflow-wrap:anywhere;
      }

      .requestPanel{
        padding: 18px;
        border-radius: 22px;
      }

      .requestHead h2{
        max-width: 9.6em;
        font-size: clamp(28px, 8vw, 36px);
        line-height:1;
        overflow-wrap: break-word;
        text-wrap: balance;
      }

      .requestRail{
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        padding: 10px;
      }

      .requestRail i{
        display:none;
      }

      .requestRail span{
        white-space:normal;
      }

      .guidanceHead{
        display:grid;
        align-items:start;
      }

      .contactGuidanceSection .interfaceMetric{
        min-height: auto;
      }
    }
  </style>
</BaseLayout>
