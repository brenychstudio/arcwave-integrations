---
import Header from "../components/Header.astro";
import WhatsAppFab from "../components/WhatsAppFab.astro";
import { site } from "../content/site";
import { siteEs } from "../content/site.es";
import { COMPANY, hasRealEmail, hasRealExternalUrl } from "../content/company";
import { langFromPath, baseFromLang, otherLangHref, t } from "../content/i18n";
import { ViewTransitions } from "astro:transitions";

type Props = {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
};

const { title, description, ogImage, noindex = false } = Astro.props as Props;

const pageTitle = title ? (title.includes(site.name) ? title : `${title} - ${site.name}`) : site.name;
const pageDescription = description ?? site.tagline;

// Canonical: production domain + pathname only (no query like ?service=...)
const siteOrigin = Astro.site ?? new URL(site.url);
const canonicalUrl = new URL(Astro.url.pathname, siteOrigin);
const canonical = canonicalUrl.toString();
const alternateHref = new URL(otherLangHref(Astro.url), siteOrigin).toString();
const xDefaultHref =
  langFromPath(Astro.url.pathname) === "es"
    ? new URL(Astro.url.pathname.replace(/^\/es(?=\/|$)/, "") || "/", siteOrigin).toString()
    : canonical;
// OG/Twitter image: always absolute URL
const ogImg = ogImage ?? site.defaultOg;
const ogImgAbs = new URL(ogImg, siteOrigin).toString();

const waNumber = String(COMPANY.phoneTel).replace(/[^\d]/g, "");
const waText = encodeURIComponent("Hi! I'd like to request a quote.");
const waHref = waNumber ? `https://wa.me/${waNumber}?text=${waText}` : null;
const mailHref = hasRealEmail(COMPANY.email) ? `mailto:${COMPANY.email}` : null;
const facebookHref = hasRealExternalUrl(COMPANY.facebookUrl) ? COMPANY.facebookUrl : null;
const linkedinHref = hasRealExternalUrl(COMPANY.linkedinUrl) ? COMPANY.linkedinUrl : null;
const sameAs = [facebookHref, linkedinHref].filter(Boolean);
const organizationJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: site.name,
  description: pageDescription,
  url: site.url,
  image: ogImgAbs,
  areaServed: site.contact.serviceArea,
  telephone: COMPANY.phoneDisplay,
  ...(mailHref ? { email: COMPANY.email } : {}),
  ...(sameAs.length ? { sameAs } : {}),
});
const websiteJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: site.name,
  url: site.url,
  inLanguage: ["en", "es"],
});
const gaId = (import.meta.env.PUBLIC_GA_ID || "").trim();
const plausibleDomain = (import.meta.env.PUBLIC_PLAUSIBLE_DOMAIN || "").trim();
const plausibleSrc = (import.meta.env.PUBLIC_PLAUSIBLE_SRC || "https://plausible.io/js/script.js").trim();
const umamiWebsiteId = (import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || "").trim();
const umamiSrc = (import.meta.env.PUBLIC_UMAMI_SRC || "https://cloud.umami.is/script.js").trim();

const lang = langFromPath(Astro.url.pathname);
const base = baseFromLang(lang);
const siteLocal = lang === "es" ? siteEs : site;

const labelContact = t(lang, "Contact", "Contacto");
const labelLegal = t(lang, "Legal", "Legal");
const labelHome = t(lang, "Home", "Inicio");
const labelServices = t(lang, "Services", "Servicios");
const labelProcess = t(lang, "Process", "Proceso");
const labelAbout = t(lang, "About", "Sobre");
const labelPrivacy = t(lang, "Privacy", "Privacidad");
const labelCookies = t(lang, "Cookies", "Cookies");
const labelSystem = t(lang, "System", "Sistema");
const labelAvailability = t(lang, "Barcelona & nearby", "Barcelona y alrededores");
const labelBrief = t(lang, "Technical brief", "Brief tecnico");
const labelQuote = t(lang, "Request a quote", "Presupuesto");
const pathParts = Astro.url.pathname.split("/").filter(Boolean);
const serviceIndex = pathParts.indexOf("services");
const serviceKey =
  serviceIndex >= 0 && pathParts[serviceIndex + 1]
    ? pathParts[serviceIndex + 1] === "cctv"
      ? "alarms"
      : pathParts[serviceIndex + 1]
    : null;
const isServiceDetail = Boolean(serviceKey);
const isContactPage = pathParts.at(-1) === "contact";
const isLegalPage =
  pathParts.includes("legal") ||
  pathParts.at(-1) === "privacy" ||
  pathParts.at(-1) === "cookies";
const showMobileBottomCta = !isContactPage && !isLegalPage;
const mobileBottomCtaLabel = t(lang, "Start request", "Iniciar solicitud");
const mobileBottomCtaHref = isServiceDetail
  ? `${base}/contact?service=${serviceKey}#quote`
  : `${base}/contact#quote`;
const creditLabel = t(lang, "Design & development", "Diseno y desarrollo");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="theme-color" content={site.accent} />
<meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow"} />

<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang={lang === "es" ? "en" : "es"} href={alternateHref} />
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- Favicons -->
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-512.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/favicon-512.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<title>{pageTitle}</title>
<meta name="description" content={pageDescription} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={pageDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === "es" ? "es_ES" : "en_US"} />
<meta property="og:locale:alternate" content={lang === "es" ? "en_US" : "es_ES"} />
<meta property="og:image" content={ogImgAbs} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={pageDescription} />
<meta name="twitter:image" content={ogImgAbs} />
<script type="application/ld+json" set:html={organizationJsonLd}></script>
<script type="application/ld+json" set:html={websiteJsonLd}></script>

{gaId ? (
  <>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script is:inline define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      window.gtag = window.gtag || gtag;
      gtag("js", new Date());
      gtag("config", gaId, { send_page_view: true });
    </script>
  </>
) : null}

{plausibleDomain ? (
  <script defer data-domain={plausibleDomain} src={plausibleSrc}></script>
) : null}

{umamiWebsiteId ? (
  <script async data-website-id={umamiWebsiteId} src={umamiSrc}></script>
) : null}

<ViewTransitions />

    <style is:global>
      :root{
        --bg:#f6f7f9;
        --bg2:#ffffff;

        --text: rgba(15,15,20,1);
        --muted: rgba(90,90,99,1);
        --muted2: rgba(120,120,132,1);

        --border: rgba(15,15,20,.10);
        --border2: rgba(15,15,20,.08);

        --card: rgba(255,255,255,.92);
        --shadow: 0 18px 48px rgba(10,10,20,.08);

        --radius: 22px;
        --radius2: 28px;

        --accent: rgb(10,132,255);
        --accentSoft: rgba(10,132,255,.10);
        --accentBorder: rgba(10,132,255,.35);

        --container: 1120px;
        --arc-shell: min(1280px, calc(100vw - 64px));
        --arc-shell-wide: min(1480px, calc(100vw - 48px));
        --arc-shell-narrow: min(1060px, calc(100vw - 48px));
        --arc-nav-shell: min(980px, calc(100vw - 48px));
        --arc-footer-shell: min(1640px, calc(100vw - clamp(28px, 5vw, 92px)));
        --site-header-space: 104px;
        --mobile-shell: min(100% - 28px, 640px);
        --mobile-section-y: 56px;
        --mobile-section-y-tight: 36px;
        --mobile-card-radius: 22px;
        --mobile-header-safe: 86px;
        /* Typography weights (Windows-friendly) */
        --w-body: 420;
        --w-ui: 600;
      }

      *{ box-sizing:border-box; }
      html, body{ height:100%; }

      /* Smooth anchor scroll */
      html{
        scroll-behavior:smooth;
        scroll-padding-top: var(--site-header-space);
      }

      /* Page transitions (video demo polish) */
      ::view-transition-old(root),
      ::view-transition-new(root){
        animation-duration: 220ms;
        animation-timing-function: ease;
      }

      @media (prefers-reduced-motion: reduce){
        html{ scroll-behavior:auto; }
        ::view-transition-old(root),
        ::view-transition-new(root){
          animation-duration: 1ms;
        }
      }

      body{
        margin:0;
        color: var(--text);
        background:
          radial-gradient(1200px 700px at 20% -10%, rgba(10,132,255,.08), transparent 55%),
          radial-gradient(900px 600px at 80% 0%, rgba(0,0,0,.04), transparent 60%),
          linear-gradient(180deg, var(--bg), var(--bg2));
        font-family: ui-sans-serif, system-ui, -apple-system, "SF Pro Display", "SF Pro Text", Inter, Segoe UI, Roboto, Arial, sans-serif;
        letter-spacing: .08px;
        font-weight: var(--w-body);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
      }

      .main{
        min-height: 100svh;
        padding-top: var(--site-header-space);
      }

      /* Keep form controls consistent */
      button, input, select, textarea{ font: inherit; }

      img{ max-width:100%; display:block; }
      a{ color: inherit; text-decoration:none; }
      a:focus-visible{ outline: 2px solid rgba(10,132,255,.45); outline-offset: 2px; border-radius: 10px; }

      .container{
        width: min(var(--container), 92vw);
        margin-inline: auto;
      }

      .mobileBottomCta{
        display:none;
      }

      .hr{ height:1px; background: var(--border2); }

      .card{
  background: var(--card);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  box-shadow: var(--shadow);

  /* FIX: cards stay readable over page glow */
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
}

      /* Buttons used across Hero + pages */
      .btn,
      a.primary, button.primary,
      a.secondary, button.secondary{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:10px;
        padding: 12px 16px;
        border-radius: 999px;
        font-weight: var(--w-ui);
        letter-spacing: .008em;
        cursor: pointer;
        user-select: none;
        -webkit-tap-highlight-color: transparent;
        transition: transform .12s ease, background .12s ease, border-color .12s ease, box-shadow .12s ease, opacity .12s ease;
      }

      .btn{ border:1px solid var(--border2); background: rgba(255,255,255,.65); }
      .btn:hover{ transform: translateY(-1px); box-shadow: 0 12px 28px rgba(10,10,20,.10); }

      .btn.primary,
      a.primary, button.primary{
        border: 1px solid var(--accentBorder);
        background: var(--accentSoft);
      }

      .btn.secondary,
      a.secondary, button.secondary{
        border: 1px solid var(--border2);
        background: rgba(255,255,255,.55);
      }

      /* IMPORTANT: Override Header CTA weight (Header.astro uses .cta with 800) */
      header.hdr .right a.cta{
        font-weight: var(--w-ui);
        letter-spacing: .008em;
      }

      @media (prefers-reduced-motion: reduce){
        .btn, a.primary, button.primary, a.secondary, button.secondary{ transition:none; }
      }

      @media (max-width: 520px){
        :root{
          --site-header-space: 92px;
        }
      }

      @media (max-width: 760px){
        :root{
          --arc-shell: min(100% - 28px, 1280px);
          --arc-shell-wide: min(100% - 24px, 1480px);
          --arc-shell-narrow: min(100% - 28px, 1060px);
          --arc-nav-shell: min(100% - 28px, 980px);
          --arc-footer-shell: min(100% - 28px, 1280px);
          --site-header-space: var(--mobile-header-safe);
        }

        html{
          scroll-padding-top: var(--mobile-header-safe);
          overflow-x:hidden;
        }

        body{
          overflow-x:hidden;
        }

        body[data-mobile-cta="true"]{
          padding-bottom: env(safe-area-inset-bottom);
        }

        .container,
        .mobile-shell{
          width: var(--mobile-shell);
          margin-inline:auto;
        }

        .mobile-section{
          padding-block: var(--mobile-section-y);
          scroll-margin-top: var(--mobile-header-safe);
        }

        .mobile-section-tight{
          padding-block: var(--mobile-section-y-tight);
        }

        .main{
          padding-top: var(--mobile-header-safe);
        }

        .btn,
        a.primary, button.primary,
        a.secondary, button.secondary{
          min-height: 44px;
          padding-inline: 15px;
        }

        .card{
          border-radius: var(--mobile-card-radius);
        }

        .mobileBottomCta{
          position:fixed;
          left: 16px;
          right: 16px;
          bottom: calc(10px + env(safe-area-inset-bottom));
          z-index:70;
          min-height: 52px;
          display:flex;
          align-items:center;
          justify-content:center;
          gap: 10px;
          border-radius:999px;
          border: 1px solid rgba(10,132,255,.34);
          background:
            linear-gradient(180deg, rgba(255,255,255,.92), rgba(234,246,255,.86));
          color: rgba(15,15,20,.92);
          box-shadow:
            inset 0 1px 0 rgba(255,255,255,.94),
            0 18px 54px rgba(10,10,20,.18);
          backdrop-filter: blur(18px) saturate(1.12);
          -webkit-backdrop-filter: blur(18px) saturate(1.12);
          font-size: 14px;
          font-weight: 760;
          letter-spacing:.02em;
          transform: translateY(calc(100% + 18px));
          opacity:0;
          pointer-events:none;
          transition: transform .18s ease, opacity .18s ease;
          -webkit-tap-highlight-color: transparent;
        }

        .mobileBottomCta:before{
          content:"";
          width: 8px;
          height: 8px;
          border-radius:999px;
          background: rgba(10,132,255,.88);
          box-shadow:
            0 0 0 5px rgba(10,132,255,.10),
            0 0 20px rgba(10,132,255,.36);
        }

        .mobileBottomCta.isReady{
          opacity:1;
          pointer-events:auto;
          transform: translateY(0);
        }

        body[data-mobile-cta="true"] .waFab{
          bottom: calc(74px + env(safe-area-inset-bottom));
        }

      }

      /* Footer */
      .ft{
  border-top: 0;
  margin-top: 56px;

  /* Extra padding gives the footer fade room without overlapping lower content. */
  padding: 88px 0 40px;

  color: var(--muted);
  font-size: 13px;

  /* The fade is painted by ::before so the footer content remains crisp. */
  background: transparent;
  position: relative;
  z-index: 1;
}

.ft:before{
  content:"";
  position:absolute;
  inset:0;
  pointer-events:none;

  /* Keep the footer fade light and atmospheric, without heavy glow. */
  background: linear-gradient(
    180deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,.72) 34%,
    rgba(255,255,255,.94) 60%,
    rgba(255,255,255,.985) 100%
  );
}

.ft > .container{
  position: relative;
  z-index: 2;
  width: var(--arc-footer-shell);
  margin-inline: auto;
}

      .ft .grid{
  display:grid;
  /* 2nd column is an intentional spacer (premium gutter) */
  grid-template-columns: 1.2fr 0.5fr 1fr 1fr;
  gap: 16px;
  align-items:start;
}

/* Move Contact and Legal into columns 3 and 4 (skip spacer column) */
.ft .grid > :nth-child(2){ grid-column: 3; }
.ft .grid > :nth-child(3){ grid-column: 4; justify-self: end; }

      .ft .k{
        font-size: 12px;
        letter-spacing: .16em;
        text-transform: uppercase;
        color: var(--muted2);
        margin-bottom: 8px;
      }
      .ft a{ color: var(--text); opacity: .72; }
      .ft a:hover{ opacity: 1; }

/* Footer social icons */
.ft .social{
  display: flex;
  gap: 10px;
  margin-top: 12px;
  align-items: center;
}

.ft .ico{
  width: 34px;
  height: 34px;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;

  background: rgba(255,255,255,.55);
  border: 1px solid var(--border2);
  color: var(--text);

  opacity: .72;
  transition: transform .12s ease, box-shadow .12s ease, background .12s ease, border-color .12s ease, opacity .12s ease;
}

.ft .ico:hover{
  opacity: 1;
  transform: translateY(-1px);
  box-shadow: 0 12px 28px rgba(10,10,20,.10);
  border-color: rgba(10,132,255,.28);
  background: rgba(10,132,255,.06);
}

.ft .ico svg{ width: 16px; height: 16px; }

@media (prefers-reduced-motion: reduce){
  .ft .ico{ transition: none; }
}

.ftBottom{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap: 12px;
}

.ftCredit{
  color: var(--muted);
  font-size: 13px;
  white-space: nowrap;
}

.ftCredit a{
  color: var(--text);
  opacity: .72;
}
.ftCredit a:hover{ opacity: 1; }

      @media (max-width: 980px){
  .ft .grid{ grid-template-columns: 1fr; }
  .ft .grid > :nth-child(2),
  .ft .grid > :nth-child(3){
    grid-column: auto;
    justify-self: start;
  }
  .ftBottom{
    flex-direction: column;
    align-items: flex-start;
  }
  .ftCredit{ white-space: normal; }
}

      .ft{
        position:relative;
        z-index:1;
        margin-top: 64px;
        padding: 112px 0 42px;
        color: var(--muted);
        font-size: 13px;
        overflow:hidden;
      }

      .ft:before{
        content:"";
        position:absolute;
        inset:0;
        pointer-events:none;
        background:
          linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.82) 28%, rgba(255,255,255,.97) 62%, rgba(255,255,255,.995) 100%),
          radial-gradient(980px 520px at 72% 8%, rgba(10,132,255,.12), transparent 62%),
          radial-gradient(620px 360px at 18% 34%, rgba(180,145,80,.052), transparent 64%);
      }

      .ft:after{
        content:"";
        position:absolute;
        left:0;
        right:0;
        top: 96px;
        height: 1px;
        pointer-events:none;
        background: linear-gradient(90deg, transparent, rgba(10,132,255,.22), rgba(15,15,20,.055), transparent);
      }

      .ftShell{
        position:relative;
        display:grid;
        grid-template-columns: minmax(280px, 1.08fr) minmax(420px, 1.5fr);
        gap: 18px;
        padding: 18px;
        border-radius: 30px;
        border: 1px solid rgba(15,15,20,.07);
        background: linear-gradient(180deg, rgba(255,255,255,.76), rgba(255,255,255,.52));
        box-shadow:
          inset 0 1px 0 rgba(255,255,255,.78),
          0 34px 90px rgba(10,10,20,.075);
        backdrop-filter: blur(22px) saturate(1.08);
        -webkit-backdrop-filter: blur(22px) saturate(1.08);
        overflow:hidden;
      }

      .ftShell:before{
        content:"";
        position:absolute;
        inset:0;
        pointer-events:none;
        background-image:
          linear-gradient(rgba(10,132,255,.035) 1px, transparent 1px),
          linear-gradient(90deg, rgba(10,132,255,.035) 1px, transparent 1px),
          radial-gradient(circle at 78% 28%, rgba(10,132,255,.105), transparent 34%);
        background-size: 56px 56px, 56px 56px, auto;
        mask-image: linear-gradient(90deg, transparent, black 22%, black 100%);
        opacity:.72;
      }

      .ftBrandPanel,
      .ftSystemPanel{
        position:relative;
        z-index:1;
      }

      .ftBrandPanel{
        min-height: 300px;
        display:flex;
        flex-direction:column;
        justify-content:space-between;
        gap: 28px;
        padding: clamp(20px, 2.6vw, 34px);
      }

      .ftBrand{
        display:flex;
        align-items:center;
        gap: 12px;
      }

      .ftMark{
        width: 10px;
        height: 10px;
        border-radius:999px;
        background: rgba(10,132,255,.88);
        box-shadow:
          0 0 0 5px rgba(10,132,255,.10),
          0 0 24px rgba(10,132,255,.35);
      }

      .ftBrand strong{
        display:block;
        color: var(--text);
        font-size: 13px;
        line-height:1;
        letter-spacing:.2em;
        text-transform:uppercase;
      }

      .ftBrand span:last-child{
        display:block;
        margin-top: 6px;
        color: var(--muted2);
        font-size: 10px;
        line-height:1;
        letter-spacing:.16em;
        text-transform:uppercase;
      }

      .ftBlurb{
        max-width: 36ch;
        margin:0;
        color: rgba(90,90,99,.88);
        line-height:1.62;
      }

      .ftStatus{
        display:flex;
        flex-wrap:wrap;
        gap: 8px;
      }

      .ftStatus span{
        display:inline-flex;
        align-items:center;
        gap: 7px;
        min-height: 32px;
        padding: 0 11px;
        border-radius:999px;
        border: 1px solid rgba(15,15,20,.07);
        background: rgba(255,255,255,.62);
        color: rgba(15,15,20,.68);
        font-size: 11px;
        font-weight: 650;
      }

      .ftStatus span:before{
        content:"";
        width: 5px;
        height: 5px;
        border-radius:999px;
        background: rgba(10,132,255,.78);
        box-shadow: 0 0 0 3px rgba(10,132,255,.09);
      }

      .ftSystemPanel{
        display:grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        padding: 8px;
      }

      .ftColumn{
        min-height: 284px;
        padding: 20px;
        border-radius: 22px;
        border: 1px solid rgba(15,15,20,.065);
        background: linear-gradient(180deg, rgba(255,255,255,.72), rgba(255,255,255,.42));
        box-shadow: inset 0 1px 0 rgba(255,255,255,.76);
      }

      .ftK{
        margin: 0 0 16px;
        color: var(--muted2);
        font-size: 11px;
        line-height:1;
        letter-spacing:.18em;
        text-transform:uppercase;
      }

      .ftLinks,
      .ftContact{
        display:grid;
        gap: 10px;
      }

      .ft a{
        color: var(--text);
        opacity:.76;
        transition: opacity .14s ease, color .14s ease, transform .14s ease;
      }

      .ft a:hover{
        opacity:1;
        color: rgba(10,132,255,1);
      }

      .ftLinks a{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap: 14px;
        min-height: 34px;
        border-bottom: 1px solid rgba(15,15,20,.055);
        font-weight: 650;
      }

