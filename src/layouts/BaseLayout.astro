    <script type="module">
      import { navigate } from "astro:transitions/client";

      // Marked links only (data-vt="1") -> force view-transition navigate()
      document.addEventListener("click", (e) => {
        const a = e.target?.closest?.('a[data-vt="1"]');
        if (!a) return;

        if (e.defaultPrevented) return;
        if (e.button !== 0) return;
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
        if (a.target && a.target !== "_self") return;

        const href = a.getAttribute("href");
        if (!href) return;

        if (href.startsWith("http") || href.startsWith("mailto:") || href.startsWith("tel:")) return;

        e.preventDefault();
        navigate(href);
      });

      // Scroll restore after swaps:
      // - with hash: scroll to hash (smooth)
      // - without hash: jump to top (instant)
      function restoreScroll() {
        const hash = window.location.hash;

        if (hash) {
          const el = document.querySelector(hash);
          if (el) el.scrollIntoView({ behavior: "smooth", block: "start" });
          return;
        }

        const html = document.documentElement;
        const prev = html.style.scrollBehavior;
        html.style.scrollBehavior = "auto";
        window.scrollTo({ top: 0, left: 0 });
        html.style.scrollBehavior = prev;
      }

      document.addEventListener("astro:page-load", restoreScroll);
      document.addEventListener("astro:after-swap", restoreScroll);

      function trackEvent(name, props = {}) {
        try {
          if (typeof window.gtag === "function") {
            window.gtag("event", name, props);
          }

          if (typeof window.plausible === "function") {
            window.plausible(name, { props });
          }

          if (window.umami && typeof window.umami.track === "function") {
            window.umami.track(name, props);
          }

          window.dispatchEvent(new CustomEvent("arcwave:analytics", { detail: { name, props } }));
        } catch {}
      }

      document.addEventListener("click", (e) => {
        const target = e.target?.closest?.("a,button");
        if (!target) return;

        const explicit = target.getAttribute("data-track");
        if (explicit) {
          trackEvent(explicit, {
            href: target.getAttribute("href") || "",
            label: (target.textContent || "").trim().slice(0, 120),
          });
          return;
        }

        const href = target.getAttribute("href") || "";
        if (href.startsWith("mailto:")) {
          trackEvent("contact_email", { href });
          return;
        }

        if (href.startsWith("tel:")) {
          trackEvent("contact_phone", { href });
          return;
        }

        if (href.includes("wa.me")) {
          trackEvent("contact_whatsapp", { href });
          return;
        }

        if (target.matches("a.primary,button.primary")) {
          trackEvent("primary_cta_click", {
            href,
            label: (target.textContent || "").trim().slice(0, 120),
          });
        }
      });

      document.addEventListener("submit", (e) => {
        const form = e.target;
        if (!(form instanceof HTMLFormElement)) return;
        if (form.getAttribute("data-track-form") !== "quote_request") return;

        trackEvent("quote_request_submit", {
          service: form.getAttribute("data-track-service") || "",
          path: window.location.pathname,
        });
      });

      window.addEventListener("arcwave:track", (e) => {
        const detail = e.detail || {};
        if (!detail.name) return;
        trackEvent(detail.name, detail.props || {});
      });

      window.addEventListener("error", (e) => {
        trackEvent("js_error", {
          message: e.message || "Unknown error",
          source: e.filename || window.location.pathname,
        });
      });

      window.addEventListener("unhandledrejection", (e) => {
        const reason = e.reason?.message || String(e.reason || "Unhandled rejection");
        trackEvent("promise_rejection", {
          message: reason.slice(0, 180),
          source: window.location.pathname,
        });
      });
    </script>

    <script is:inline>
      (() => {
        const mq = window.matchMedia("(max-width: 760px)");

        function wrapIndex(index, length) {
          return ((index % length) + length) % length;
        }

        function circularOffset(index, activeIndex, length) {
          let offset = index - activeIndex;
          const half = length / 2;
          if (offset > half) offset -= length;
          if (offset < -half) offset += length;
          return offset;
        }

        function formatCount(index, total) {
          return `${String(index + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}`;
        }

        function getCarouselItems(root) {
          const items = Array.from(root.children).filter((child) => {
            return child instanceof HTMLElement
              && child.getAttribute("data-mobile-carousel-exclude") !== "true"
              && !child.classList.contains("mobileCarouselControls")
              && !child.classList.contains("mobileCarouselDots");
          });

          const mobileLimit = Number(root.getAttribute("data-mobile-carousel-mobile-limit") || 0);
          if (mq.matches && Number.isFinite(mobileLimit) && mobileLimit > 0) {
            return items.slice(0, mobileLimit);
          }

          return items;
        }

        function resetArcwaveMobileCarousel(root) {
          root.querySelectorAll(".mobileCarouselControls, .mobileCarouselDots").forEach((node) => node.remove());
          root.classList.remove("isMobileCarousel");
          root.removeAttribute("data-mobile-carousel-ready");
          root.removeAttribute("role");
          root.removeAttribute("aria-roledescription");

          root.querySelectorAll("[data-mobile-carousel-item]").forEach((item) => {
            item.removeAttribute("data-mobile-carousel-item");
            item.removeAttribute("data-carousel-offset");
            item.removeAttribute("aria-hidden");
            item.removeAttribute("aria-label");
            if ("tabIndex" in item) item.removeAttribute("tabindex");
          });
        }

        function initArcwaveMobileCarousels() {
          if (!mq.matches) return;

          document.querySelectorAll("[data-mobile-carousel]").forEach((root) => {
            if (root.getAttribute("data-mobile-carousel-ready") === "true") return;

            const items = getCarouselItems(root);

            if (items.length < 3) return;

            root.setAttribute("data-mobile-carousel-ready", "true");
            root.classList.add("isMobileCarousel");
            root.setAttribute("role", "region");
            root.setAttribute("aria-roledescription", "carousel");
            root.setAttribute("aria-label", root.getAttribute("data-mobile-carousel-label") || "Mobile carousel");

            const controls = document.createElement("div");
            controls.className = "mobileCarouselControls";
            controls.innerHTML = `
              <button type="button" data-carousel-prev aria-label="Previous item" title="Previous">&lt;</button>
              <span class="mobileCarouselCount" aria-live="polite"></span>
              <button type="button" data-carousel-next aria-label="Next item" title="Next">&gt;</button>
            `;

            const dots = document.createElement("div");
            dots.className = "mobileCarouselDots";
            dots.setAttribute("aria-label", "Carousel navigation");

            items.forEach((item, index) => {
              item.setAttribute("data-mobile-carousel-item", "");
              item.setAttribute("aria-label", `${index + 1} of ${items.length}`);

              const dot = document.createElement("button");
              dot.type = "button";
              dot.setAttribute("aria-label", `Show item ${index + 1}`);
              dot.addEventListener("click", () => select(index));
              dots.appendChild(dot);
            });

            root.prepend(controls);
            root.appendChild(dots);

            const count = controls.querySelector(".mobileCarouselCount");
            const prev = controls.querySelector("[data-carousel-prev]");
            const next = controls.querySelector("[data-carousel-next]");
            const dotButtons = Array.from(dots.querySelectorAll("button"));
            let activeIndex = Number(root.getAttribute("data-mobile-carousel-start") || 0);
            let pointerStartX = 0;
            let pointerStartY = 0;
            let tracking = false;

            function update() {
              activeIndex = wrapIndex(activeIndex, items.length);
              if (count) count.textContent = formatCount(activeIndex, items.length);

              items.forEach((item, index) => {
                const offset = circularOffset(index, activeIndex, items.length);
                const visibleOffset = Math.abs(offset) <= 1 ? String(offset) : "hidden";
                item.setAttribute("data-carousel-offset", visibleOffset);
                item.setAttribute("aria-hidden", index === activeIndex ? "false" : "true");
                if ("tabIndex" in item) item.tabIndex = index === activeIndex ? 0 : -1;
              });

              dotButtons.forEach((dot, index) => {
                dot.setAttribute("aria-pressed", index === activeIndex ? "true" : "false");
              });
            }

            function select(index) {
              activeIndex = wrapIndex(index, items.length);
              update();
            }

            prev?.addEventListener("click", () => select(activeIndex - 1));
            next?.addEventListener("click", () => select(activeIndex + 1));

            root.addEventListener("pointerdown", (event) => {
              if (!mq.matches) return;
              if (event.target?.closest?.("button")) return;
              tracking = true;
              pointerStartX = event.clientX;
              pointerStartY = event.clientY;
            }, { passive: true });

            root.addEventListener("pointerup", (event) => {
              if (!tracking) return;
              tracking = false;
              const dx = event.clientX - pointerStartX;
              const dy = event.clientY - pointerStartY;
              if (Math.abs(dx) < 42 || Math.abs(dx) < Math.abs(dy) * 1.12) return;
              select(activeIndex + (dx < 0 ? 1 : -1));
            }, { passive: true });

            root.addEventListener("pointercancel", () => {
              tracking = false;
            }, { passive: true });

            update();
          });
        }

        function syncArcwaveMobileCarousels() {
          document.querySelectorAll("[data-mobile-carousel-ready='true']").forEach((root) => {
            if (!mq.matches) resetArcwaveMobileCarousel(root);
          });

          initArcwaveMobileCarousels();
        }

        syncArcwaveMobileCarousels();
        mq.addEventListener?.("change", syncArcwaveMobileCarousels);
        window.addEventListener("resize", syncArcwaveMobileCarousels, { passive: true });
        document.addEventListener("astro:page-load", syncArcwaveMobileCarousels);
        document.addEventListener("astro:after-swap", syncArcwaveMobileCarousels);
      })();
    </script>

    {showMobileBottomCta ? (
      <a class="mobileBottomCta" href={mobileBottomCtaHref} data-mobile-bottom-cta data-vt="1" data-track="mobile_bottom_cta">
        {mobileBottomCtaLabel}
      </a>
    ) : null}

    {showMobileBottomCta ? (
      <script is:inline>
        (() => {
          function initArcwaveMobileBottomCta() {
            const cta = document.querySelector("[data-mobile-bottom-cta]");
            const footer = document.querySelector(".ft");
            if (!cta || !footer) return;
            if (cta.getAttribute("data-mobile-observed") === "true") return;
            cta.setAttribute("data-mobile-observed", "true");

            const homeHero = document.querySelector("#signal-field");
            const hero =
              homeHero ||
              document.querySelector(".interfaceHero") ||
              document.querySelector("main > section");

            let heroVisible = Boolean(hero);
            let footerVisible = false;
            const getScrollTop = () =>
              window.scrollY ||
              document.documentElement.scrollTop ||
              document.body.scrollTop ||
              0;
            let pastThreshold = getScrollTop() > window.innerHeight * 0.6;

            const sync = () => {
              if (homeHero) {
                const rect = homeHero.getBoundingClientRect();
                heroVisible = rect.bottom > window.innerHeight * 0.18 && rect.top < window.innerHeight * 0.58;
              } else if (hero) {
                heroVisible = getScrollTop() <= window.innerHeight * 0.6;
              }
              cta.classList.toggle("isReady", pastThreshold && !heroVisible && !footerVisible);
            };

            const onScroll = () => {
              pastThreshold = getScrollTop() > window.innerHeight * 0.6;
              sync();
            };

            window.addEventListener("scroll", onScroll, { passive: true });
            document.addEventListener("scroll", onScroll, { passive: true });

            if ("IntersectionObserver" in window) {
              const footerObserver = new IntersectionObserver(
                ([entry]) => {
                  footerVisible = Boolean(entry?.isIntersecting);
                  sync();
                },
                { rootMargin: "0px 0px -18% 0px", threshold: 0 }
              );

              const heroObserver = hero
                ? new IntersectionObserver(
                    () => sync(),
                    { rootMargin: "-12% 0px -42% 0px", threshold: 0 }
                  )
                : null;

              footerObserver.observe(footer);
              heroObserver?.observe(hero);
            }

            sync();
          }

          initArcwaveMobileBottomCta();
          document.addEventListener("astro:after-swap", initArcwaveMobileBottomCta);
        })();
      </script>
    ) : null}

    <WhatsAppFab />
  </body>
</html>
